{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "TASNADI",
		"description": "TASNADI website: blog posts, pages and case study content",
		"author": "TASNADI"
	},
	"settings": {
		"title": "TASNADI",
		"tagline": "Egyszerűen jobb üzlet."
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Blog posts",
			"labelSingular": "Blog post",
			"urlPattern": "/posts/{slug}",
			"supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		},
		{
			"slug": "industries",
			"label": "Industries",
			"labelSingular": "Industry",
			"description": "Industries a case study belongs to",
			"urlPattern": "/industries/{slug}",
			"supports": ["drafts", "revisions", "preview", "search"],
			"titleField": "title",
			"fields": [
				{
					"slug": "title",
					"label": "Name",
					"type": "string",
					"required": true,
					"searchable": true
				}
			]
		},
		{
			"slug": "services",
			"label": "Services",
			"labelSingular": "Service",
			"description": "Service categories a case study belongs to",
			"urlPattern": "/services/{slug}",
			"supports": ["drafts", "revisions", "preview", "search"],
			"titleField": "title",
			"fields": [
				{
					"slug": "title",
					"label": "Name",
					"type": "string",
					"required": true,
					"searchable": true
				}
			]
		},
		{
			"slug": "team_members",
			"label": "Team members",
			"labelSingular": "Team member",
			"description": "Behind the scenes team members credited on case studies",
			"urlPattern": "/team/{slug}",
			"supports": ["drafts", "revisions", "preview", "search"],
			"titleField": "title",
			"admin": {
				"listColumns": ["position"]
			},
			"fields": [
				{
					"slug": "title",
					"label": "Name",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "position",
					"label": "Position",
					"type": "string"
				},
				{
					"slug": "default_image",
					"label": "Default image (1:1 square)",
					"type": "image"
				},
				{
					"slug": "hover_image",
					"label": "Hover image (1:1 square, shown on hover over the default image)",
					"type": "image"
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": ["posts"]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": ["posts"]
		}
	]
}
