---
import ProcessStepCard from "./ProcessStepCard.astro";

type Tone = 1 | 2 | 3 | 4;

type Phase = {
	label: string;
	/** Number of week columns the phase covers */
	span: number;
	tone: Tone;
};

type Step = {
	title: string;
	text: string;
	tone: Tone;
	/** First week column of the step (1-based) */
	column: number;
	/** Number of week columns the step covers */
	span: number;
	/** Step row (1-based, below the phase row) */
	row: number;
};

type Props = {
	weeks: string[];
	phases: Phase[];
	steps: Step[];
	/** Accessible name of the scrollable region */
	label: string;
	class?: string;
};

const { weeks, phases, steps, label, class: className } = Astro.props;

const rowCount = Math.max(...steps.map((step) => step.row));

const phaseTones: Record<Tone, string> = {
	1: "bg-process-phase-1 text-text-inverse",
	2: "bg-process-phase-2 text-text-inverse",
	3: "bg-process-phase-3 text-text-inverse",
	4: "bg-process-phase-4 text-text",
};
---

<div
	data-drag-scroll
	role="region"
	aria-label={label}
	tabindex="0"
	class:list={[
		"cursor-grab overflow-x-auto overscroll-x-contain [scrollbar-width:none] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent data-dragging:cursor-grabbing data-dragging:select-none [&::-webkit-scrollbar]:hidden",
		className,
	]}
>
	<div class="w-max px-[max(4%,calc((100%_-_76.875rem)/2))]">
		<div
			class="grid gap-x-px gap-y-1 rounded-[10px] border border-border-inverse bg-[repeating-linear-gradient(90deg,transparent_0_200px,var(--color-process-grid-line)_200px_201px)]"
			style={`grid-template-columns: repeat(${weeks.length}, 200px); grid-template-rows: auto auto repeat(${rowCount}, auto);`}
		>
			{
				weeks.map((week) => (
					<div class="flex items-center justify-center px-3 py-1 text-sm text-text-inverse">{week}</div>
				))
			}

			{
				phases.map((phase) => (
					<div
						class:list={["rounded-[10px] px-3 py-0.5 text-base leading-5 font-medium", phaseTones[phase.tone]]}
						style={`grid-column: span ${phase.span};`}
					>
						{phase.label}
					</div>
				))
			}

			{
				steps.map((step) => (
					<ProcessStepCard
						title={step.title}
						text={step.text}
						tone={step.tone}
						style={`grid-column: ${step.column} / span ${step.span}; grid-row: ${step.row + 2};`}
					/>
				))
			}
		</div>
	</div>
</div>

<script>
	// Lets mouse users drag the timeline sideways (touch and trackpads scroll it natively).
	document.querySelectorAll<HTMLElement>("[data-drag-scroll]").forEach((scroller) => {
		let pointerId: number | null = null;
		let startX = 0;
		let startScroll = 0;

		scroller.addEventListener("pointerdown", (event) => {
			if (event.pointerType !== "mouse" || event.button !== 0) return;
			pointerId = event.pointerId;
			startX = event.clientX;
			startScroll = scroller.scrollLeft;
			scroller.setPointerCapture(pointerId);
			scroller.dataset.dragging = "";
		});

		scroller.addEventListener("pointermove", (event) => {
			if (event.pointerId !== pointerId) return;
			event.preventDefault();
			scroller.scrollLeft = startScroll - (event.clientX - startX) * 2;
		});

		const stop = (event: PointerEvent) => {
			if (event.pointerId !== pointerId) return;
			pointerId = null;
			delete scroller.dataset.dragging;
		};
		scroller.addEventListener("pointerup", stop);
		scroller.addEventListener("pointercancel", stop);
		scroller.addEventListener("lostpointercapture", stop);
	});
</script>
