---
import { getRelativeLocaleUrl } from "astro:i18n";
import Button from "./Button.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import NavDropdown from "./NavDropdown.astro";
import { hasLocaleContent, isPathAvailable } from "../utils/locale-content";

type Locale = "hu" | "en";

type Props = {
	locale?: Locale;
	/** "light" = white bar on dark pages, "dark" = dark bar on light pages */
	variant?: "light" | "dark";
};

const { variant = "light" } = Astro.props;
const isDark = variant === "dark";

const locale: Locale =
	Astro.props.locale ?? (Astro.currentLocale === "en" ? "en" : "hu");

const currentPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";
const withoutTrailingSlash = (path: string) => path.replace(/(.)\/$/, "$1");
// A page that has no English version sends the EN switch to the English home page instead of a missing page
const englishPath = (await isPathAvailable(currentPath, "en")) ? currentPath : "/";
const languageHrefs = {
	hu: withoutTrailingSlash(getRelativeLocaleUrl("hu", currentPath)),
	en: withoutTrailingSlash(getRelativeLocaleUrl("en", englishPath)),
};

const aboutHref = withoutTrailingSlash(getRelativeLocaleUrl(locale, "/about"));
const contactHref = withoutTrailingSlash(getRelativeLocaleUrl(locale, "/contact"));
const blogHref = withoutTrailingSlash(getRelativeLocaleUrl(locale, "/blog"));
const servicesHref = withoutTrailingSlash(getRelativeLocaleUrl(locale, "/services"));
const workHref = withoutTrailingSlash(getRelativeLocaleUrl(locale, "/projects"));
const podcastHref = withoutTrailingSlash(getRelativeLocaleUrl(locale, "/podcast"));

const copy = {
	hu: {
		mainNavigation: "Főmenü",
		menu: "Menü",
		language: "Nyelv",
		services: "Szolgáltatásaink",
		work: "Munkáink",
		method: "Módszer",
		about: "Rólunk",
		insights: "Tudástár",
		cta: "Beszélgessünk!",
		insightGroups: [
			{
				items: [
					{ label: "Blog", href: blogHref, collection: "posts" },
					{ label: "Podcast", href: podcastHref, collection: "podcasts" },
				],
			},
		],
	},
	en: {
		mainNavigation: "Main navigation",
		menu: "Menu",
		language: "Language",
		services: "Services",
		work: "Work",
		method: "Method",
		about: "About",
		insights: "Insights",
		cta: "Let's talk!",
		insightGroups: [
			{
				items: [
					{ label: "Blog", href: blogHref, collection: "posts" },
					{ label: "Podcast", href: podcastHref, collection: "podcasts" },
				],
			},
		],
	},
}[locale];

type CopyGroup = {
	heading?: string;
	items: { label: string; href?: string; badge?: string; collection?: string }[];
};

// Items tied to a collection are hidden while that collection has no entries in the current language
const collectionsWithContent = new Set(
	(
		await Promise.all(
			["posts", "podcasts"].map(async (collection) =>
				(await hasLocaleContent(collection, locale)) ? collection : null,
			),
		)
	).filter((collection) => collection !== null),
);

const toGroups = (groups: CopyGroup[]) =>
	groups
		.map((group) => ({
			...group,
			items: group.items
				.filter((item) => !item.collection || collectionsWithContent.has(item.collection))
				.map((item) => ({ ...item, href: item.href ?? "#" })),
		}))
		.filter((group) => group.items.length > 0);

const insightGroups = toGroups(copy.insightGroups);

const surfaceClass = isDark ? "bg-surface-dark" : "bg-background";
const textClass = isDark ? "text-text-inverse" : "text-text";
const logoSrc = isDark ? "/global/branding/logo-light.svg" : "/global/branding/logo.svg";

const linkClass =
	`block rounded-full px-5 py-2 xl:px-4 text-base font-medium ${textClass} transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent`;
---

<header
	data-site-nav
	data-hidden="false"
	data-menu-open="false"
	class="group/nav pointer-events-none fixed inset-x-0 top-6 z-100 px-4 transition-transform duration-300 ease-out data-[hidden=true]:-translate-y-[calc(100%+5rem)] motion-reduce:transition-none"
>
	<nav
		aria-label={copy.mainNavigation}
		class:list={[
			"pointer-events-auto relative mx-auto flex h-[4.125rem] max-w-[70rem] items-center justify-between rounded-full pr-3 pl-6 max-[22.5rem]:pr-1 max-[22.5rem]:pl-4 shadow-[0_4px_30px_color-mix(in_srgb,var(--color-shadow)_10%,transparent)] xl:pr-8 xl:pl-8",
			surfaceClass,
		]}
	>
		<a
			href="/"
			class="flex shrink-0 items-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
			aria-label="TASNADI"
		>
			<img
				src={logoSrc}
				alt=""
				width="1067"
				height="188"
				class="h-[1.125rem] w-auto max-[22.5rem]:h-4"
			/>
		</a>

		<div class="flex items-center gap-1 max-[22.5rem]:gap-0 xl:hidden">
			<Button
				variant="primary"
				href={contactHref}
				class="whitespace-nowrap max-xl:px-5 max-xl:py-2.5 max-sm:px-4 max-sm:py-2 max-sm:text-sm max-[22.5rem]:px-3"
			>
				{copy.cta}
			</Button>

			<button
				type="button"
				data-nav-toggle
				aria-expanded="false"
				aria-controls="site-nav-panel"
				aria-label={copy.menu}
				class:list={["flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent", textClass]}
			>
				<span class="relative block size-[1.875rem]" aria-hidden="true">
					<span
						class="absolute top-1/2 left-1.25 -mt-px h-0.5 w-5 -translate-y-1.5 rounded-full bg-current transition duration-200 group-data-[menu-open=true]/nav:translate-y-0 group-data-[menu-open=true]/nav:rotate-45 motion-reduce:transition-none"
					></span>
					<span
						class="absolute top-1/2 left-1.25 -mt-px h-0.5 w-5 rounded-full bg-current transition duration-200 group-data-[menu-open=true]/nav:opacity-0 motion-reduce:transition-none"
					></span>
					<span
						class="absolute top-1/2 left-1.25 -mt-px h-0.5 w-5 translate-y-1.5 rounded-full bg-current transition duration-200 group-data-[menu-open=true]/nav:translate-y-0 group-data-[menu-open=true]/nav:-rotate-45 motion-reduce:transition-none"
					></span>
				</span>
			</button>
		</div>

		<div
			id="site-nav-panel"
			class:list={[
				"absolute inset-x-0 top-full mt-3 hidden flex-col gap-6 rounded-[24px] p-6 shadow-[0_4px_30px_color-mix(in_srgb,var(--color-shadow)_10%,transparent)] group-data-[menu-open=true]/nav:flex max-xl:max-h-[calc(100dvh-7rem)] max-xl:overflow-y-auto max-xl:overscroll-contain xl:static xl:mt-0 xl:flex xl:flex-row xl:items-center xl:gap-4 xl:rounded-none xl:bg-transparent xl:p-0 xl:shadow-none",
				surfaceClass,
			]}
		>
			<ul class="flex flex-col gap-1 xl:flex-row xl:items-center xl:gap-0">
				<li><a href={servicesHref} class={linkClass}>{copy.services}</a></li>
				<li><a href={workHref} class={linkClass}>{copy.work}</a></li>
				<li><a href="#" class={linkClass}>{copy.method}</a></li>
				<li><a href={aboutHref} class={linkClass}>{copy.about}</a></li>
				{insightGroups.length > 0 && <NavDropdown label={copy.insights} groups={insightGroups} {variant} />}
			</ul>

			<div class="flex flex-col gap-6 xl:flex-row xl:items-center xl:gap-5">
				<Button variant="primary" href={contactHref} class="w-full xl:w-auto">
					{copy.cta}
				</Button>
				<LanguageSwitcher
					{locale}
					{variant}
					hrefs={languageHrefs}
					label={copy.language}
					class="justify-center"
				/>
			</div>
		</div>
	</nav>
</header>

<script>
	// Hides the main navigation while scrolling down and reveals it again while scrolling up.
	const nav = document.querySelector<HTMLElement>("[data-site-nav]");

	if (nav) {
		const scrollThreshold = 8;
		let lastScrollY = window.scrollY;
		let isTicking = false;

		const setHidden = (hidden: boolean) => {
			nav.dataset.hidden = String(hidden);
		};

		const hasKeyboardFocus = () => nav.matches(":has(:focus-visible)");

		const update = () => {
			const scrollY = Math.max(window.scrollY, 0);
			const delta = scrollY - lastScrollY;
			const mustStayVisible =
				scrollY <= nav.offsetHeight ||
				nav.dataset.menuOpen === "true" ||
				hasKeyboardFocus();
			const hasMovedEnough = Math.abs(delta) >= scrollThreshold;

			if (mustStayVisible) setHidden(false);
			else if (hasMovedEnough) setHidden(delta > 0);

			if (mustStayVisible || hasMovedEnough) lastScrollY = scrollY;
			isTicking = false;
		};

		window.addEventListener(
			"scroll",
			() => {
				if (isTicking) return;
				isTicking = true;
				requestAnimationFrame(update);
			},
			{ passive: true },
		);

		nav.addEventListener("focusin", () => {
			if (hasKeyboardFocus()) setHidden(false);
		});
	}
</script>

<script>
	// Opens and closes the mobile navigation panel (button, Escape, link click or switch to desktop width) and locks page scroll while it is open.
	const nav = document.querySelector<HTMLElement>("[data-site-nav]");
	const toggle = nav?.querySelector<HTMLButtonElement>("[data-nav-toggle]");

	if (nav && toggle) {
		const desktop = window.matchMedia("(min-width: 80rem)");

		const setOpen = (open: boolean) => {
			nav.dataset.menuOpen = String(open);
			toggle.setAttribute("aria-expanded", String(open));
			// Lock page scroll while the menu is open, keeping the scrollbar gutter to avoid a layout shift
			document.documentElement.style.overflow = open ? "hidden" : "";
			document.documentElement.style.scrollbarGutter = open ? "stable" : "";
		};

		toggle.addEventListener("click", () =>
			setOpen(nav.dataset.menuOpen !== "true"),
		);

		nav.addEventListener("click", (event) => {
			if ((event.target as Element).closest("a")) setOpen(false);
		});

		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape" || nav.dataset.menuOpen !== "true") return;
			setOpen(false);
			toggle.focus();
		});

		desktop.addEventListener("change", () => setOpen(false));
	}
</script>
