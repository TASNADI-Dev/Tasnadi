---
type Props = {
	/** Plain part of the title */
	titleStart?: string;
	/** Highlighted (primary color) end of the title */
	titleHighlight: string;
	/** Plain part of the title after the highlight */
	titleEnd?: string;
	/** Short intro shown under the title */
	text?: string;
};

const { titleStart, titleHighlight, titleEnd, text } = Astro.props;
---

<section class="relative bg-background pt-[11.25rem] pb-10 max-lg:pt-40">
	<img
		src="/global/images/page-hero-bg.webp"
		srcset="/global/images/page-hero-bg-mobile.webp 800w, /global/images/page-hero-bg.webp 2000w"
		sizes="100vw"
		alt=""
		width="2000"
		height="1403"
		loading="eager"
		fetchpriority="high"
		class="absolute inset-0 size-full object-cover object-[50%_60%]"
	/>

	<div class="relative z-10 mx-auto w-[92%] max-w-[76.875rem] text-center">
		<h1
			class:list={[
				"text-[4.375rem] leading-[5.25rem] font-medium tracking-[-0.02em] text-text-inverse max-lg:text-[2.1875rem] max-lg:leading-[2.75rem]",
				text ? "mb-6" : "mb-[6.25rem] max-lg:mb-36",
			]}
		>
			{titleStart && `${titleStart} `}<span class="text-primary">{titleHighlight}</span>{titleEnd && ` ${titleEnd}`}
		</h1>
		{
			text && (
				<p class="mx-auto mb-[6.25rem] max-w-[34rem] text-xl leading-8 font-light text-text-inverse max-lg:mb-44 max-lg:text-lg max-lg:leading-7">
					{text}
				</p>
			)
		}
	</div>
</section>
