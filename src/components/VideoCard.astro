---
type Props = {
	src: string;
	poster: string;
	/** Accessible label of the play button */
	playLabel: string;
	name?: string;
	role?: string;
	class?: string;
};

const { src, poster, playLabel, name, role, class: className } = Astro.props;
---

<figure data-video-card class:list={["flex w-full max-w-[18.75rem] flex-col items-center", className]}>
	<div class="relative aspect-square w-full overflow-hidden rounded-[20px] bg-gray-900 shadow-[0_8px_32px_color-mix(in_srgb,var(--color-primary)_25%,transparent)]">
		<video
			class="size-full object-cover"
			playsinline
			preload="none"
			poster={poster}
			src={src}
			data-video
		></video>
		<button
			type="button"
			aria-label={playLabel}
			aria-pressed="false"
			data-video-toggle
			class="group absolute inset-0 flex cursor-pointer items-center justify-center focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent"
		>
			<span
				class="flex size-[3.25rem] items-center justify-center rounded-full bg-primary text-white shadow-[0_2px_8px_color-mix(in_srgb,var(--color-gray-900)_40%,transparent)] transition duration-200 group-hover:scale-110 group-hover:bg-primary-hover group-aria-[pressed=true]:opacity-0 motion-reduce:transition-none"
			>
				<svg width="18" height="20" viewBox="0 0 18 20" fill="currentColor" class="ml-1" aria-hidden="true">
					<path d="M17 8.27a2 2 0 0 1 0 3.46L3 19.8A2 2 0 0 1 0 18.07V1.93A2 2 0 0 1 3 .2l14 8.07Z"></path>
				</svg>
			</span>
		</button>
	</div>
	{
		(name || role) && (
			<figcaption class="mt-5 text-center">
				{name && <p class="text-xl leading-7 font-medium text-white">{name}</p>}
				{role && <p class="mt-1 text-sm leading-5 font-light text-gray-300">{role}</p>}
			</figcaption>
		)
	}
</figure>

<script>
	// Toggles the video between play and pause when it is clicked, with no native controls.
	document.querySelectorAll<HTMLElement>("[data-video-card]").forEach((card) => {
		const video = card.querySelector<HTMLVideoElement>("[data-video]");
		const toggle = card.querySelector<HTMLButtonElement>("[data-video-toggle]");
		if (!video || !toggle) return;

		toggle.addEventListener("click", () => {
			if (video.paused) void video.play();
			else video.pause();
		});
		video.addEventListener("play", () => toggle.setAttribute("aria-pressed", "true"));
		video.addEventListener("pause", () => toggle.setAttribute("aria-pressed", "false"));
	});
</script>
