---
import type { HTMLAttributes } from "astro/types";
import { Image } from "emdash/ui";
import Badge from "./Badge.astro";

type Props = Omit<HTMLAttributes<"article">, "title"> & {
	href: string;
	title: string;
	description: string;
	image: Parameters<typeof Image>[0]["image"];
	/** Service names shown as badges above the title */
	services?: string[];
};

const {
	href,
	title,
	description,
	image,
	services = [],
	class: className,
	...rest
} = Astro.props;
---

<article
	{...rest}
	class:list={[
		"group relative flex h-full flex-col overflow-hidden rounded-[20px] bg-background text-text shadow-[0_2px_2px_color-mix(in_srgb,var(--color-shadow)_20%,transparent)] transition duration-300 hover:shadow-[0_8px_20px_color-mix(in_srgb,var(--color-shadow)_25%,transparent)] motion-reduce:transition-none",
		className,
	]}
>
	<div class="aspect-[3/2] overflow-hidden bg-surface">
		<Image
			image={image}
			sizes="(min-width: 64rem) 25rem, (min-width: 40rem) 50vw, 92vw"
			loading="lazy"
			class="size-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
		/>
	</div>

	<div class="flex flex-1 flex-col items-start gap-3 p-6">
		{
			services.length > 0 && (
				<ul class="flex flex-wrap gap-2">
					{services.map((service) => (
						<li>
							<Badge>{service}</Badge>
						</li>
					))}
				</ul>
			)
		}
		<h3 class="text-xl leading-8 font-medium">
			<a
				href={href}
				class="no-underline transition-colors duration-200 group-hover:text-primary after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
			>
				{title}
			</a>
		</h3>
		<p class="line-clamp-4 text-base leading-[1.625rem] font-light text-text-muted">
			{description}
		</p>
	</div>
</article>
