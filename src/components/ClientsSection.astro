---
type TitlePart = { text: string; tone?: "primary" | "accent" };

type ClientVideo = {
	/** Client name shown under the video */
	name: string;
	src: string;
	poster?: string;
};

type Props = {
	title: TitlePart[];
	items: ClientVideo[];
	prevLabel: string;
	nextLabel: string;
	class?: string;
};

const { title, items, prevLabel, nextLabel, class: className } = Astro.props;

const arrowClass =
	"flex size-[3.125rem] cursor-pointer items-center justify-center rounded-full border-2 border-primary bg-transparent text-primary transition-colors duration-200 hover:bg-primary/10 active:bg-primary active:text-text-inverse disabled:cursor-default disabled:opacity-40 disabled:hover:bg-transparent motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
---

<section
	data-clients
	class:list={["relative overflow-hidden bg-background pt-16 pb-[6.875rem] max-md:py-[3.125rem]", className]}
>
	<div class="mx-auto w-[92%] max-w-[76.875rem]">
		<h2 class="text-center text-[3rem] leading-normal font-medium text-text max-[30rem]:text-[1.875rem]">
			{
				title.map((part) => (
					<>
						<span
							class:list={[
								part.tone === "primary" && "text-primary",
								part.tone === "accent" && "text-accent",
							]}
						>
							{part.text}
						</span>{" "}
					</>
				))
			}
		</h2>

		<div class="swiper mt-8" data-clients-slider>
			<ul class="swiper-wrapper">
				{
					items.map((item) => (
						<li class="swiper-slide">
							<video
								class="aspect-video w-full rounded-[20px] bg-surface-dark object-cover"
								controls
								playsinline
								preload="metadata"
								poster={item.poster}
								src={item.src}
								aria-label={item.name}
							/>
							<p class="mt-3 text-center text-base leading-6 font-medium text-text">{item.name}</p>
						</li>
					))
				}
			</ul>
		</div>

		<div class="mt-8 flex items-center justify-center gap-4">
			<button type="button" aria-label={prevLabel} data-clients-prev class={arrowClass}>
				<svg width="23" height="15" viewBox="0 0 23 15" fill="currentColor" aria-hidden="true">
					<path d="M21.387 8.451a1 1 0 0 0 0-2v2ZM1.2 6.744a1 1 0 0 0 0 1.414l6.364 6.364a1 1 0 0 0 1.414-1.414L3.32 7.451l5.657-5.657A1 1 0 0 0 7.563.38L1.2 6.744Zm20.187-.293H1.906v2h19.48v-2Z"></path>
				</svg>
			</button>
			<button type="button" aria-label={nextLabel} data-clients-next class={arrowClass}>
				<svg width="23" height="15" viewBox="0 0 23 15" fill="currentColor" aria-hidden="true">
					<path d="M1.906 6.451a1 1 0 0 0 0 2v-2Zm20.188 1.707a1 1 0 0 0 0-1.414L15.73.38a1 1 0 0 0-1.414 1.414l5.657 5.657-5.657 5.657a1 1 0 0 0 1.414 1.414l6.364-6.364ZM1.906 8.451h19.48v-2H1.906v2Z"></path>
				</svg>
			</button>
		</div>

		<slot />
	</div>

	<slot name="decoration" />
</section>

<script>
	// Sets up the client video slider with Swiper and pauses a video once its slide scrolls away.
	import Swiper from "swiper";
	import { Navigation } from "swiper/modules";
	import "swiper/css";

	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	document.querySelectorAll<HTMLElement>("[data-clients]").forEach((section) => {
		const slider = section.querySelector<HTMLElement>("[data-clients-slider]");
		const prevEl = section.querySelector<HTMLElement>("[data-clients-prev]");
		const nextEl = section.querySelector<HTMLElement>("[data-clients-next]");
		if (!slider || !prevEl || !nextEl) return;

		const swiper = new Swiper(slider, {
			modules: [Navigation],
			slidesPerView: 1,
			spaceBetween: 16,
			speed: reduceMotion ? 0 : 300,
			simulateTouch: false,
			navigation: { prevEl, nextEl },
			breakpoints: {
				768: { slidesPerView: 2 },
				992: { slidesPerView: 3 },
			},
		});

		swiper.on("slideChange", () => {
			slider.querySelectorAll("video").forEach((video) => video.pause());
		});
	});
</script>
