---
import type { HTMLAttributes } from "astro/types";

type Variant = "solid" | "outline";

type Props = HTMLAttributes<"span"> & {
	variant?: Variant;
};

const { variant = "solid", class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
	solid: "bg-accent font-medium text-white",
	outline: "border border-accent bg-background font-light text-accent",
};
---

<span
	{...rest}
	class:list={[
		"inline-block rounded-full px-3 py-1 text-xs leading-4 whitespace-nowrap",
		variants[variant],
		className,
	]}
>
	<slot />
</span>
