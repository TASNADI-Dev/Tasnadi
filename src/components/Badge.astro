---
import type { HTMLAttributes } from "astro/types";

type Variant = "solid" | "outline";

type Props = HTMLAttributes<"span"> & {
	variant?: Variant;
};

const { variant = "solid", class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
	solid: "border-accent bg-accent text-text-inverse",
	outline: "border-accent bg-background text-accent",
};
---

<span
	{...rest}
	class:list={[
		"inline-block rounded-full border px-3 py-1 text-xs leading-4 font-medium whitespace-nowrap",
		variants[variant],
		className,
	]}
>
	<slot />
</span>
