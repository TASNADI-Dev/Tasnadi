---
import type { HTMLAttributes } from "astro/types";
import { Image } from "emdash/ui";
import Badge from "./Badge.astro";

type Props = Omit<HTMLAttributes<"article">, "title"> & {
	href: string;
	title: string;
	image: Parameters<typeof Image>[0]["image"];
	/** Category name shown as an outline badge over the image */
	category?: string;
	/** Publish date, shown below the title */
	date?: Date | null;
	/** BCP 47 locale used to format the date, e.g. "hu" */
	locale?: string;
};

const { href, title, image, category, date, locale = "hu", class: className, ...rest } = Astro.props;

const formatter = new Intl.DateTimeFormat(locale, {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "Europe/Budapest",
});
---

<article
	{...rest}
	class:list={[
		"group relative grid min-h-[10.75rem] grid-cols-[1fr_2fr] overflow-hidden rounded-[8px] bg-background text-text shadow-[0_2px_4px_color-mix(in_srgb,var(--color-gray-900)_20%,transparent)] transition duration-300 hover:shadow-[0_10px_25px_color-mix(in_srgb,var(--color-gray-900)_25%,transparent)] motion-reduce:transition-none max-[30rem]:grid-cols-1",
		className,
	]}
>
	<div class="relative overflow-hidden bg-surface max-[30rem]:aspect-video">
		<Image
			image={image}
			sizes="(min-width: 64rem) 13rem, (min-width: 30rem) 30vw, 92vw"
			loading="lazy"
			class="size-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
		/>
		{category && <Badge variant="outline" class="absolute top-2 left-2">{category}</Badge>}
	</div>

	<div class="flex flex-col justify-center gap-2 p-4">
		<h3 class="line-clamp-2 text-xl leading-[1.625rem] font-medium">
			<a
				href={href}
				class="no-underline transition-colors duration-200 group-hover:text-primary after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
			>
				{title}
			</a>
		</h3>
		{
			date && (
				<time datetime={date.toISOString()} class="text-xs leading-4 font-medium">
					{formatter.format(date)}
				</time>
			)
		}
	</div>
</article>
