---
import type { ComponentProps } from "astro/types";
import BlogCard from "./BlogCard.astro";
import Button from "./Button.astro";
import PodcastCard from "./PodcastCard.astro";

type TitlePart = { text: string; tone?: "primary" | "accent" };

type Props = {
	podcasts: {
		title: TitlePart[];
		moreCta: string;
		moreHref: string;
		items: ComponentProps<typeof PodcastCard>[];
	};
	posts: {
		title: TitlePart[];
		moreCta: string;
		moreHref: string;
		items: ComponentProps<typeof BlogCard>[];
	};
};

const { podcasts, posts } = Astro.props;

// A column without items (nothing published in this language) is left out, and the section with it when both are empty
const columns = [
	{ ...podcasts, kind: "podcasts" as const },
	{ ...posts, kind: "posts" as const },
].filter((column) => column.items.length > 0);
---

{columns.length > 0 && (
<section class="bg-surface-dark pt-8 pb-20 max-md:pt-4 max-md:pb-16">
	<div
		class:list={[
			"mx-auto grid w-[92%] max-w-[76.875rem] gap-x-12 gap-y-16 max-lg:grid-cols-1",
			columns.length > 1 ? "grid-cols-2" : "grid-cols-1",
		]}
	>
		{
			columns.map((column) => (
				<div class="flex min-w-0 flex-col">
					<h2 class="mb-10 text-[3rem] leading-normal font-medium text-text-inverse max-[30rem]:mb-6 max-[30rem]:text-[1.875rem]">
						{column.title.map((part) => (
							<>
								<span class:list={[part.tone === "primary" && "text-primary"]}>{part.text}</span>{" "}
							</>
						))}
					</h2>

					<ul class="flex flex-col gap-8">
						{column.kind === "podcasts"
							? column.items.map((item) => (
									<li>
										<PodcastCard {...item} />
									</li>
								))
							: column.items.map((item) => (
									<li>
										<BlogCard {...item} />
									</li>
								))}
					</ul>

					<div class="mt-8">
						<Button variant="link-arrow" href={column.moreHref}>
							{column.moreCta}
						</Button>
					</div>
				</div>
			))
		}
	</div>
</section>
)}
