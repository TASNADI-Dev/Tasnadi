---
type Props = {
	locale?: "hu" | "en";
	/** Link for each language, defaults to "#" */
	hrefs?: Partial<Record<"hu" | "en", string>>;
	/** Accessible name of the language group */
	label?: string;
	class?: string;
};

const {
	locale = "hu",
	hrefs = {},
	label = "Language",
	class: className,
} = Astro.props;

const languages = [
	{ code: "en", label: "EN", href: hrefs.en ?? "#" },
	{ code: "hu", label: "HU", href: hrefs.hu ?? "#" },
] as const;
---

<ul class:list={["flex items-center gap-3", className]} aria-label={label}>
	{
		languages.map(({ code, label: text, href }) => (
			<li>
				<a
					{href}
					lang={code}
					hreflang={code}
					aria-current={code === locale ? "true" : undefined}
					class:list={[
						"border-b-2 pb-0.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
						code === locale
							? "border-primary text-primary"
							: "border-transparent text-text-muted hover:text-text",
					]}
				>
					{text}
				</a>
			</li>
		))
	}
</ul>
