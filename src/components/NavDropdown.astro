---
import Badge from "./Badge.astro";

type Props = {
	label: string;
	/** Match the navigation variant */
	variant?: "light" | "dark";
	groups: {
		/** Subtitle shown above the group, with a divider above it on desktop */
		heading?: string;
		items: { label: string; href: string; badge?: string }[];
	}[];
};

const { label, groups, variant = "light" } = Astro.props;
const isDark = variant === "dark";

const textClass = isDark ? "text-text-inverse" : "text-text";
const panelClass = isDark ? "nav:bg-surface-dark" : "nav:bg-background";
const dividerClass = isDark ? "border-border-inverse" : "border-border";
const headingClass = isDark ? "text-text-inverse-subtle" : "text-text-subtle";
const itemHoverClass = isDark ? "hover:bg-surface-dark-hover" : "hover:bg-surface";
---

<li data-dropdown data-open="false" class="group/dropdown relative">
	<button
		type="button"
		class:list={[
			"flex w-full cursor-pointer items-center gap-2 rounded-full px-5 py-2 text-left text-base font-medium transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent group-focus-within/dropdown:text-primary max-nav:group-data-[open=true]/dropdown:text-primary nav:w-auto nav:px-4",
			textClass,
		]}
	>
		{label}
		<svg
			class="shrink-0 transition-transform duration-200 group-focus-within/dropdown:rotate-180 group-hover/dropdown:rotate-180 max-nav:group-data-[open=true]/dropdown:rotate-180"
			width="10"
			height="6"
			viewBox="0 0 10 6"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M1 1l4 4 4-4"></path>
		</svg>
	</button>

	<div
		class="hidden group-data-[open=true]/dropdown:block nav:pointer-events-none nav:absolute nav:block nav:top-full nav:left-0 nav:translate-y-1 nav:pt-3 nav:opacity-0 nav:transition nav:duration-200 nav:group-focus-within/dropdown:pointer-events-auto nav:group-focus-within/dropdown:translate-y-0 nav:group-focus-within/dropdown:opacity-100 nav:group-hover/dropdown:pointer-events-auto nav:group-hover/dropdown:translate-y-0 nav:group-hover/dropdown:opacity-100"
	>
		<ul
			class:list={[
				"flex flex-col max-nav:ml-5 max-nav:border-l nav:min-w-[15rem] nav:rounded-[16px] nav:p-2 nav:shadow-[0_4px_30px_color-mix(in_srgb,var(--color-shadow)_12%,transparent)]",
				dividerClass,
				panelClass,
			]}
		>
			{
				groups.map((group) => (
					<>
						{group.heading && (
							<li
								class:list={[
									"mt-2 px-4 pb-1 text-sm font-medium nav:-mx-2 nav:mt-2 nav:border-t nav:px-4 nav:pt-3 nav:pb-1",
									headingClass,
									dividerClass,
								]}
							>
								{group.heading}
							</li>
						)}
						{group.items.map((item) => (
							<li>
								<a
									href={item.href}
									class:list={[
										"flex items-center gap-3 rounded-[8px] px-4 py-2 text-base font-medium whitespace-nowrap transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent nav:px-2 nav:py-2.5",
										textClass,
										itemHoverClass,
									]}
								>
									{item.label}
									{item.badge && <Badge>{item.badge}</Badge>}
								</a>
							</li>
						))}
					</>
				))
			}
		</ul>
	</div>
</li>

<script>
	// Expands and collapses the dropdowns in the mobile navigation (desktop uses hover and focus via CSS).
	const dropdowns = document.querySelectorAll<HTMLElement>("[data-dropdown]");
	const desktop = window.matchMedia("(min-width: 66rem)");

	const setOpen = (dropdown: HTMLElement, open: boolean) => {
		const button = dropdown.querySelector("button");
		dropdown.dataset.open = String(open);
		if (desktop.matches) button?.removeAttribute("aria-expanded");
		else button?.setAttribute("aria-expanded", String(open));
	};

	const reset = () => dropdowns.forEach((dropdown) => setOpen(dropdown, false));

	dropdowns.forEach((dropdown) => {
		dropdown.querySelector("button")?.addEventListener("click", () => {
			if (desktop.matches) return;
			setOpen(dropdown, dropdown.dataset.open !== "true");
		});
	});

	reset();
	desktop.addEventListener("change", reset);
</script>
