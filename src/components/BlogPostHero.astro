---
import { Image } from "emdash/ui";
import Badge from "./Badge.astro";

type Props = {
	/** Post title, rendered as the page H1 */
	title: string;
	/** Short intro paragraph under the title */
	summary?: string;
	/** Category name shown as a badge above the title */
	category?: string;
	/** Post image, shown on the right (below the text on small screens) */
	image?: Parameters<typeof Image>[0]["image"];
};

const { title, summary, category, image } = Astro.props;
---

<section class="bg-background pt-[11.25rem] pb-12 max-lg:pt-40 max-lg:pb-10">
	<div
		class="mx-auto grid w-[92%] max-w-[76.875rem] items-center gap-12 lg:grid-cols-2 lg:gap-16 max-lg:gap-8"
	>
		<div class="flex flex-col items-start gap-5">
			{category && <Badge variant="solid">{category}</Badge>}
			<h1
				class="text-[2.5rem] leading-[3rem] font-medium tracking-[-0.02em] max-lg:text-[1.75rem] max-lg:leading-[2.25rem]"
			>
				{title}
			</h1>
			{summary && <p class="text-base leading-[1.625rem] font-medium text-text-muted">{summary}</p>}
		</div>

		{
			image && (
				<Image
					image={image}
					sizes="(min-width: 64rem) 37rem, 92vw"
					loading="eager"
					fetchpriority="high"
					class="h-auto w-full rounded-[20px] max-lg:order-first"
				/>
			)
		}
	</div>
</section>
