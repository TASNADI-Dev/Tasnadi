---
import { getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { currentPage, localizePath, type Locale } from "../i18n/routes";
import { getPageAlternates } from "../utils/locale-content";
import { resolveSiteIdentity } from "../utils/site-identity";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import WithoutHreflang from "../components/WithoutHreflang.astro";
import "../styles/global.css";

interface Props {
	title: string;
	/** Title typed into the EmDash SEO title field: shown as the whole tab title, without the site name suffix */
	titleOverride?: string | null;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Navigation bar style: "light" (default) or "dark" */
	navVariant?: "light" | "dark";
	/** The page's URL in each language it exists in; static pages get it from the route map */
	alternates?: Partial<Record<Locale, string>>;
}

const {
	title,
	titleOverride,
	pageTitle,
	description,
	image,
	canonical,
	content,
	navVariant = "light",
} = Astro.props;
const page = currentPage(Astro.url, Astro.currentLocale);
const isNotFound = page.path === "/404";
const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);

const { siteTitle, siteTagline } = resolveSiteIdentity(
	settingsResult.data,
);
// Browser tab title pattern: "Page name | TASNADI"
// A CMS SEO title may already end with the site name, so every trailing copy is stripped before adding it once
const titleSuffix = ` | ${siteTitle}`;
let pageName = title;
while (pageName.endsWith(titleSuffix)) {
	pageName = pageName.slice(0, -titleSuffix.length);
}
const fullTitle =
	titleOverride?.trim() ||
	(pageName === siteTitle || pageName === "" ? siteTitle : `${pageName}${titleSuffix}`);
const pageDescription = description ?? siteTagline;

// Canonical and hreflang URLs follow the route map (Hungarian slugs, English under /en); x-default is English, as on the original site
const origin = (settingsResult.data.url || Astro.url.origin).replace(/\/$/, "");
const alternates = isNotFound ? {} : (Astro.props.alternates ?? (await getPageAlternates(page.path)));
const canonicalUrl =
	canonical !== undefined ? canonical : isNotFound ? null : `${origin}${localizePath(page.path, page.locale)}`;
const hreflangLinks = Object.keys(alternates).length > 1
	? [
			...Object.entries(alternates).map(([hreflang, path]) => ({ hreflang, href: `${origin}${path}` })),
			{ hreflang: "x-default", href: `${origin}${alternates.en ?? alternates.hu}` },
		]
	: [];

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical: canonicalUrl,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang={page.locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/global/branding/favicon.png" />
		<title>{fullTitle}</title>
		<WithoutHreflang><EmDashHead page={pageCtx} /></WithoutHreflang>
		{hreflangLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
	</head>
	<body class="flex min-h-screen flex-col">
		<EmDashBodyStart page={pageCtx} />

		<Navigation variant={navVariant} languageHrefs={alternates} />

		<main class="flex-1">
			<slot />
		</main>

		<Footer />

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
