---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Badge from "../components/Badge.astro";
import AgencyIntro from "../components/AgencyIntro.astro";
import ClientsSection from "../components/ClientsSection.astro";
import ClutchReviews from "../components/ClutchReviews.astro";
import Button from "../components/Button.astro";
import MediaSection from "../components/MediaSection.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { clientVideos } from "../utils/client-videos";
import { localizePath } from "../i18n/routes";
import { hasLocaleContent } from "../utils/locale-content";
import { resolveSiteIdentity } from "../utils/site-identity";

const { siteTagline } = resolveSiteIdentity(
	await getSiteSettings(),
);

const locale = Astro.currentLocale === "en" ? "en" : "hu";

// Same Formspark endpoint and Cloudflare Turnstile site key as the live Webflow site
const contactForm = {
	action: "https://submit-form.com/fWyEEvKks",
	turnstileSiteKey: "0x4AAAAAACK5HFavcDJe9wjU",
};

const copy = {
	hu: {
		pageTitle: "Webdizájn és branding ügynökség",
		titleStart: "Egyszerűen",
		titleHighlight: "jobb üzlet.",
		text: "Digitális megoldások kívül-belül: több ügyfél, kevesebb káosz.",
		primaryCta: "Szolgáltatásaink",
		secondaryCta: "Mérd fel a céged digitális érettségét",
		services: {
			badge: "Szolgáltatásaink",
			title: [
				{ text: "Így tesszük jobbá", tone: "primary" },
				{ text: "digitális jelenlétedet" },
			],
			items: [
				{
					icon: "website" as const,
					slug: "website",
					title: "Weboldalak",
					text: "Gondoskodunk róla, hogy weboldalad könnyen érthető legyen, és cégedet megbízhatónak mutassa.",
				},
				{
					icon: "webshop" as const,
					slug: "webshops",
					title: "Webshopok",
					text: "Hatékony és erős webshop megoldással indítjuk be az online értékesítésedet.",
				},
				{
					icon: "branding" as const,
					slug: "branding",
					title: "Branding",
					text: "Megkönnyítjük ügyfeleidnek, hogy megértsék: te vagy a legjobb választás számukra.",
				},
				{
					icon: "consulting" as const,
					slug: "consulting",
					title: "Tanácsadás",
					text: "Segítünk a megfelelő stratégia kidolgozásában, hogy kitűnj a piacon.",
				},
			],
			moreCta: "Bővebben",
		},
		caseStudy: {
			title: [{ text: "Sikertörténeteink", tone: "primary" }],
			cta: "Tovább olvasom",
			moreCta: "További projektek",
		},
		intro: {
			badge: "Legendás ügyfélélmény",
			title: [
				{ text: "Digitális," },
				{ text: "emberi módon.", tone: "primary" as const },
			],
			text: "A TASNADI budapesti digitális ügynökség kis- és középvállalkozások számára. Hisszük, hogy a jó eredmény jó kapcsolatból születik: előbb meghallgatunk, mindent átláthatóvá teszünk, érthetően beszélünk, és teljes felelősséget vállalunk az eredményért – így a közös munka ugyanolyan jó, mint maga az eredmény.",
			links: [
				{ label: "Nézd meg, hogyan dolgozunk", href: localizePath("/method", "hu") },
				{ label: "Ismerd meg a csapatot", href: localizePath("/about", "hu") },
			],
			video: {
				src: "/home/owner/video-hu.mp4",
				poster: "/home/owner/video-poster.webp",
				playLabel: "Videó lejátszása",
				name: "Tasnádi Olivér",
				role: "Tulajdonos, stratégiai vezető",
			},
		},
		media: {
			podcasts: {
				title: [{ text: "Hallgasd" }, { text: "podcastünket", tone: "primary" as const }],
				moreCta: "További epizódok",
				listenLabel: "Podcast meghallgatása:",
			},
			posts: {
				title: [{ text: "Olvasd el" }, { text: "gondolatainkat", tone: "primary" as const }],
				moreCta: "További cikkek",
			},
		},
		clients: {
			title: [{ text: "Néhány" }, { text: "elégedett", tone: "primary" as const }, { text: "ügyfelünk" }],
			prevLabel: "Előző videó",
			nextLabel: "Következő videó",
		},
		contact: {
			title: [{ text: "Gondolkozol egy projekten?" }, { text: "Beszélgessünk!", tone: "primary" as const }],
			form: {
				...contactForm,
				successMessage: "Vissza",
				labels: { name: "Név", phone: "Telefon", email: "E-mail", message: "Üzenet" },
				placeholders: {
					name: "Kovács János",
					phone: "+36201234567",
					email: "kovacs.janos@vallalat.hu",
					message: "Rövid leírás a megkeresés céljáról",
				},
				consent: "Hozzájárulok személyes adataim marketingcélú feldolgozásához.",
				submit: "Küldés",
				success: "Köszönjük! Sikeres küldés.",
				error: "Hoppá! Az űrlap elküldésekor valami rosszul sült el.",
			},
		},
	},
	en: {
		pageTitle: "Web design and branding agency",
		titleStart: "Simply",
		titleHighlight: "better business.",
		text: "Digital solutions, inside and out: more clients, less chaos.",
		primaryCta: "Our services",
		secondaryCta: "Assess your company’s digital maturity",
		services: {
			badge: "Our services",
			title: [
				{ text: "Here’s how we enhance", tone: "primary" },
				{ text: "your digital presence" },
			],
			items: [
				{
					icon: "website" as const,
					slug: "website",
					title: "Websites",
					text: "We make sure your website is easy to comprehend and makes your company look trustworthy.",
				},
				{
					icon: "webshop" as const,
					slug: "webshops",
					title: "E-commerce",
					text: "We launch your online sales with an efficient and powerful e-commerce solution.",
				},
				{
					icon: "branding" as const,
					slug: "branding",
					title: "Branding",
					text: "We make it easy for your customers to understand: you are their best choice.",
				},
				{
					icon: "consulting" as const,
					slug: "consulting",
					title: "Consulting",
					text: "We help you create a strategy for standing out in your market.",
				},
			],
			moreCta: "Find out more",
		},
		caseStudy: {
			title: [
				{ text: "See our" },
				{ text: "success stories", tone: "primary" },
			],
			cta: "See more",
			moreCta: "More projects",
		},
		intro: {
			badge: "Legendary client experience",
			title: [
				{ text: "Digital," },
				{ text: "made human.", tone: "primary" as const },
			],
			text: "TASNADI is a Budapest-based digital agency for small and medium-sized businesses. We believe great results grow from great relationships: we listen first, keep things transparent, explain them simply, and take full responsibility for the outcome – so working with us feels as good as the result.",
			links: [
				{ label: "See how we work", href: localizePath("/method", "en") },
				{ label: "Meet the team", href: localizePath("/about", "en") },
			],
			video: {
				src: "/home/owner/video-en.mp4",
				poster: "/home/owner/video-poster.webp",
				playLabel: "Play video",
				name: "Oliver Tasnadi",
				role: "Owner, strategist",
			},
		},
		media: {
			podcasts: {
				title: [{ text: "Listen to our" }, { text: "podcasts", tone: "primary" as const }],
				moreCta: "Show more episodes",
				listenLabel: "Listen on",
			},
			posts: {
				title: [{ text: "Read our" }, { text: "insights", tone: "primary" as const }],
				moreCta: "Show more articles",
			},
		},
		clients: {
			title: [{ text: "Some of our" }, { text: "happy", tone: "primary" as const }, { text: "clients" }],
			prevLabel: "Previous video",
			nextLabel: "Next video",
		},
		contact: {
			title: [{ text: "Have a project in mind?" }, { text: "Let's talk!", tone: "primary" as const }],
			form: {
				...contactForm,
				successMessage: "Back",
				labels: { name: "Name", phone: "Phone", email: "Email", message: "Message" },
				placeholders: {
					name: "John Doe",
					phone: "+36201234567",
					email: "john.doe@organization.com",
					message: "Short description of reason for contacting us",
				},
				consent: "I agree with the processing of my personal data for marketing purposes.",
				submit: "Send",
				success: "Thank you! Your submission has been received!",
				error: "Oops! Something went wrong while submitting the form.",
			},
		},
	},
}[locale];

const { entries: featuredCaseStudies, cacheHint: caseStudyListHint } = await getEmDashCollection(
	"case_studies",
	{
		locale,
		where: { featured: "1" },
		orderBy: { published_at: "desc" },
		limit: 1,
	},
);
if (Astro.cache?.enabled) Astro.cache.set(caseStudyListHint);

const featuredCaseStudySlug = featuredCaseStudies[0]?.data.slug;

const { entry: caseStudy, cacheHint: caseStudyHint } = featuredCaseStudySlug
	? await getEmDashEntry("case_studies", featuredCaseStudySlug, {
			locale,
			references: { industry: true, services: true },
		})
	: { entry: undefined, cacheHint: undefined };
if (caseStudyHint && Astro.cache?.enabled) Astro.cache.set(caseStudyHint);

const caseStudyHref = localizePath(`/case-studies/${caseStudy?.data.slug}`, locale);
const caseStudyServices = caseStudy?.references?.services.entries ?? [];
const caseStudyIndustry = caseStudy?.references?.industry.entries[0];
const caseStudyLabels = [
	...caseStudyServices.map((service) => service.data.title),
	...(caseStudyIndustry ? [caseStudyIndustry.data.title] : []),
];

const { entries: latestCaseStudies, cacheHint: latestCaseStudiesHint } =
	await getEmDashCollection("case_studies", {
		locale,
		orderBy: { published_at: "desc" },
	});
if (Astro.cache?.enabled) Astro.cache.set(latestCaseStudiesHint);

// The newest three case studies that are not the highlighted (featured) one
const listedCaseStudySlugs = latestCaseStudies
	.filter((entry) => !entry.data.featured)
	.slice(0, 3)
	.map((entry) => entry.data.slug);

const listedCaseStudies = (
	await Promise.all(
		listedCaseStudySlugs.map(async (slug) => {
			const { entry, cacheHint } = await getEmDashEntry("case_studies", slug, {
				locale,
				references: { services: true },
			});
			if (cacheHint && Astro.cache?.enabled) Astro.cache.set(cacheHint);
			return entry;
		}),
	)
).filter((entry) => entry !== undefined);

// Podcasts and blog posts that are not translated stay out of the English page (the media section hides an empty column)
const loadLatest = async <T extends "podcasts" | "posts">(collection: T) => {
	if (!(await hasLocaleContent(collection, locale))) return [];
	const { entries, cacheHint } = await getEmDashCollection(collection, {
		locale,
		orderBy: { published_at: "desc" },
		limit: 3,
	});
	if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
	return entries;
};

const latestPodcasts = await loadLatest("podcasts");
const latestPostList = await loadLatest("posts");

const latestPosts = (
	await Promise.all(
		latestPostList
			.map((entry) => entry.data.slug)
			.filter((slug): slug is string => Boolean(slug))
			.map(async (slug) => {
				const { entry: post, cacheHint } = await getEmDashEntry("posts", slug, {
					locale,
					references: { category: true },
				});
				if (cacheHint && Astro.cache?.enabled) Astro.cache.set(cacheHint);
				return post;
			}),
	)
).filter((post) => post != null);

// The contact section shows the owner; name, position and both photos come from the team members collection
const { entry: contactPerson, cacheHint: contactPersonHint } = await getEmDashEntry(
	"team_members",
	"oliver-tasnadi",
	{ locale },
);
if (contactPersonHint && Astro.cache?.enabled) Astro.cache.set(contactPersonHint);

const mediaSection = {
	podcasts: {
		...copy.media.podcasts,
		moreHref: localizePath("/podcast", locale),
		items: latestPodcasts.map((entry) => ({
			href: localizePath(`/podcast/${entry.data.slug}`, locale),
			title: entry.data.title,
			image: entry.data.image,
			listenLabel: copy.media.podcasts.listenLabel,
			links: [
				{ platform: "spotify" as const, url: entry.data.spotify_link },
				{ platform: "youtube" as const, url: entry.data.youtube_link },
				{ platform: "apple-podcasts" as const, url: entry.data.apple_podcasts_link },
				{ platform: "youtube-music" as const, url: entry.data.youtube_music_link },
				{ platform: "soundcloud" as const, url: entry.data.soundcloud_link },
			],
		})),
	},
	posts: {
		...copy.media.posts,
		moreHref: localizePath("/blog", locale),
		items: latestPosts.map((post) => ({
			href: localizePath(`/blog/${post.data.slug}`, locale),
			title: post.data.title,
			image: post.data.image,
			category: post.references?.category.entries[0]?.data.title,
			date: post.data.publishedAt,
			locale,
		})),
	},
};

const labelClass = "text-base leading-[1.625rem] font-medium text-accent";
const fieldClass =
	"w-full rounded-[5px] border border-border-strong bg-background px-3 text-base font-medium text-text placeholder:font-normal placeholder:text-text-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
---

<Base title={copy.pageTitle} description={siteTagline}>
	<section
		class="relative overflow-hidden pt-[11.875rem] pb-[12.25rem]"
	>
		<img
			src="/home/hero/bg.webp"
			alt=""
			width="3024"
			height="1520"
			loading="eager"
			fetchpriority="high"
			class="absolute inset-0 size-full object-cover object-[50%_100%] max-lg:hidden"
		/>
		<img
			src="/home/hero/bg-mobile.webp"
			alt=""
			width="1500"
			height="1948"
			loading="eager"
			class="absolute inset-x-0 bottom-0 hidden h-auto w-full object-cover object-[50%_100%] max-lg:block"
		/>

		<img
			src="/home/hero/planet-2.webp"
			alt=""
			width="255"
			height="255"
			loading="eager"
			class="absolute top-[33%] right-[29%] z-1 w-[7.96875rem] max-lg:hidden"
		/>
		<img
			src="/home/hero/planet-1.webp"
			alt=""
			width="74"
			height="71"
			loading="eager"
			class="absolute right-[47%] bottom-[20%] z-1 w-[4.625rem] max-lg:hidden"
		/>
		<img
			src="/global/images/planet-3.webp"
			alt=""
			width="217"
			height="307"
			loading="eager"
			class="absolute top-[6%] right-0 z-1 w-[13.5625rem] max-lg:hidden"
		/>

		<div class="relative z-10 mx-auto w-[92%] max-w-[76.875rem]">
			<h1
				class="max-w-[32.5rem] pr-10 font-medium text-text text-display"
			>
				{copy.titleStart}{" "}
				<span class="text-primary">{copy.titleHighlight}</span>
			</h1>

			<div class="w-full max-w-[48.125rem] max-lg:w-4/5 max-sm:w-auto">
				<p
					class="my-10 pr-15 text-xl leading-[1.875rem] font-medium text-text max-lg:pr-0"
				>
					{copy.text}
				</p>

				<div
					class="flex items-center gap-8 max-md:flex-col max-md:items-start max-md:gap-4"
				>
					<Button variant="primary" href="#services">
						{copy.primaryCta}
					</Button>
					<Button variant="link-arrow" href="#">
						{copy.secondaryCta}
					</Button>
				</div>
			</div>
		</div>
	</section>

	<section
		id="services"
		class="relative bg-surface-dark py-20 max-[30rem]:py-[3.125rem]"
	>
		<img
			src="/global/images/space-bg.webp"
			alt=""
			width="1512"
			height="1294"
			loading="lazy"
			class="absolute inset-0 size-full object-cover object-top max-[30rem]:object-bottom"
		/>

		<div
			class="relative z-10 mx-auto grid w-[92%] max-w-[76.875rem] grid-cols-[1.2fr_1fr] items-start gap-8 max-lg:grid-cols-1"
		>
			<div class="top-28 self-start lg:sticky">
				<Badge class="align-top">{copy.services.badge}</Badge>

				<h2
					class="mt-5 max-w-[30rem] font-medium text-text-inverse text-heading"
				>
					{
						copy.services.title.map((part) => (
							<>
								<span class:list={[part.tone === "primary" && "text-primary"]}>
									{part.text}
								</span>{" "}
							</>
						))
					}
				</h2>
			</div>

			<ul class="relative z-10 flex flex-col gap-6">
				{
					copy.services.items.map((item) => (
						<ServiceCard
							icon={item.icon}
							title={item.title}
							text={item.text}
							href={localizePath(`/services/${item.slug}`, locale)}
							moreLabel={copy.services.moreCta}
						/>
					))
				}
			</ul>
		</div>
	</section>

	{
		caseStudy && (
		<section id="success-stories" class="relative overflow-hidden bg-background pt-[4.375rem] pb-32 max-md:pb-24">
			<img
				src="/global/images/planet-3.webp"
				alt=""
				width="217"
				height="307"
				loading="lazy"
				class="absolute top-[4rem] right-0 w-[13.5625rem] max-lg:w-[8rem] max-md:hidden"
			/>
			<img
				src="/home/case-study/curve.svg"
				alt=""
				width="1513"
				height="212"
				loading="lazy"
				class="pointer-events-none absolute inset-x-0 bottom-0 h-auto w-full"
			/>

			<div class="relative z-10 mx-auto w-[92%] max-w-[76.875rem]">
				<h2 class="font-medium text-text text-heading">
					{copy.caseStudy.title.map((part) => (
						<>
							<span
								class:list={[
									part.tone === "primary" && "text-primary",
									part.tone === "accent" && "text-accent",
								]}
							>
								{part.text}
							</span>{" "}
						</>
					))}
				</h2>

				<div class="mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-10 max-lg:grid-cols-1">
					<div class="max-w-[34rem]">
						{caseStudyLabels.length > 0 && (
							<ul class="flex flex-wrap gap-3">
								{caseStudyLabels.map((label) => (
									<li>
										<Badge>{label}</Badge>
									</li>
								))}
							</ul>
						)}
						<h3
							{...caseStudy.edit.hero_text}
							class="mt-5 text-[2.125rem] leading-[2.75rem] font-medium text-text max-[30rem]:text-[1.75rem] max-[30rem]:leading-9"
						>
							<a href={caseStudyHref} class="no-underline">
								{caseStudy.data.hero_text}
							</a>
						</h3>
						<p
							{...caseStudy.edit.short_description}
							class="mt-4 text-base leading-[1.625rem] font-light text-text"
						>
							{caseStudy.data.short_description}
						</p>
						<Button
							variant="primary"
							href={caseStudyHref}
							class="mt-6"
						>
							{copy.caseStudy.cta}
						</Button>
					</div>

					<div class="relative -mb-32 pt-20 max-lg:pt-14">
						<img
							src="/home/case-study/spaceship.webp"
							alt=""
							width="580"
							height="378"
							loading="lazy"
							data-spaceship
							class="absolute -top-24 left-0 w-[13.75rem] will-change-transform max-lg:right-24 max-lg:left-auto max-lg:w-[9rem]"
						/>
						<div {...caseStudy.edit.image}>
							<Image
								image={caseStudy.data.image}
								sizes="(min-width: 64rem) 38rem, 92vw"
								loading="lazy"
								class="relative h-auto w-full"
							/>
						</div>
					</div>
				</div>
			</div>
		</section>
		)
	}

	{
		listedCaseStudies.length > 0 && (
			<section class="bg-background pt-16 pb-24 max-md:pt-12 max-md:pb-20">
				<div class="mx-auto w-[92%] max-w-[76.875rem]">
					<ul class="grid grid-cols-3 gap-8 max-lg:grid-cols-1">
						{listedCaseStudies.map((entry) => (
							<li>
								<CaseStudyCard
									href={localizePath(`/case-studies/${entry.data.slug}`, locale)}
									title={entry.data.hero_text}
									description={entry.data.short_description}
									image={entry.data.thumbnail}
									services={entry.references?.services.entries.map(
										(service) => service.data.title,
									)}
								/>
							</li>
						))}
					</ul>

					<div class="mt-12 flex justify-end">
						<Button variant="link-arrow" href={localizePath("/case-studies", locale)}>
							{copy.caseStudy.moreCta}
						</Button>
					</div>
				</div>
			</section>
		)
	}

	<AgencyIntro {...copy.intro} />

	<MediaSection {...mediaSection} />

	<ClientsSection {...copy.clients} items={clientVideos}>
		<ClutchReviews />

		<img
			slot="decoration"
			src="/home/testimonials/astronaut.webp"
			alt=""
			width="908"
			height="1301"
			loading="lazy"
			class="pointer-events-none absolute right-0 -bottom-[5%] z-1 h-auto w-80 animate-float motion-reduce:animate-none max-lg:hidden"
		/>
	</ClientsSection>

	{
		contactPerson && (
		<section class="relative overflow-hidden bg-surface-dark pt-[9.375rem] pb-[10.625rem] max-lg:py-20">
			<img
				src="/global/images/footer-bg.webp"
				alt=""
				width="1512"
				height="1270"
				loading="lazy"
				class="absolute inset-0 size-full object-cover object-[50%_60%]"
			/>

			<div class="relative z-10 mx-auto w-[92%] max-w-[76.875rem]">
				<h2 class="mb-12 font-medium text-text-inverse text-heading">
					{
						copy.contact.title.map((part) => (
							<>
								<span
									class:list={[
										part.tone === "primary" && "text-primary",
										part.tone === "accent" && "text-accent",
									]}
								>
									{part.text}
								</span>{" "}
							</>
						))
					}
				</h2>

				<div class="flex items-start gap-20 max-lg:flex-col max-lg:gap-12">
					<div class="min-w-0 flex-1 max-lg:w-full">
						<div>
							<form
								action={copy.contact.form.action}
								method="post"
								class="grid grid-cols-2 gap-x-9 gap-y-5 max-md:grid-cols-1"
							>
								<input type="hidden" name="utm_source" />
								<input type="hidden" name="utm_medium" />
								<input type="hidden" name="utm_campaign" id="utm_campaign" />
								<input type="hidden" name="utm_term" />
								<input type="hidden" name="utm_content" />
								<input type="hidden" name="_feedback.whitelabel" value="true" />
								<input type="hidden" name="_feedback.dark" value="true" />
								<input type="hidden" name="_feedback.success.message" value={copy.contact.form.successMessage} />

								<div class="flex flex-col gap-1">
									<label for="contact-name" class={labelClass}>{copy.contact.form.labels.name}</label>
									<input
										id="contact-name"
										name="name"
										type="text"
										maxlength="256"
										required
										autocomplete="name"
										placeholder={copy.contact.form.placeholders.name}
										class:list={[fieldClass, "h-[3.25rem]"]}
									/>
								</div>

								<div class="flex flex-col gap-1">
									<label for="contact-phone" class={labelClass}>{copy.contact.form.labels.phone}</label>
									<input
										id="contact-phone"
										name="Phone"
										type="tel"
										maxlength="256"
										autocomplete="tel"
										placeholder={copy.contact.form.placeholders.phone}
										class:list={[fieldClass, "h-[3.25rem]"]}
									/>
								</div>

								<div class="flex flex-col gap-1">
									<label for="contact-email" class={labelClass}>{copy.contact.form.labels.email}</label>
									<input
										id="contact-email"
										name="Email"
										type="email"
										maxlength="256"
										required
										autocomplete="email"
										placeholder={copy.contact.form.placeholders.email}
										class:list={[fieldClass, "h-[3.25rem]"]}
									/>
								</div>

								<div class="flex flex-col gap-1 md:col-start-2 md:row-span-3 md:row-start-1">
									<label for="contact-message" class={labelClass}>{copy.contact.form.labels.message}</label>
									<textarea
										id="contact-message"
										name="Message"
										maxlength="5000"
										placeholder={copy.contact.form.placeholders.message}
										class:list={[fieldClass, "min-h-[10rem] flex-1 resize-y py-3"]}
									></textarea>
								</div>

								<label class="relative col-span-full mt-2 flex cursor-pointer items-center gap-3">
									<input
										type="checkbox"
										name="checkbox"
										required
										class="peer size-5 shrink-0 cursor-pointer appearance-none rounded-[2px] border border-border-strong bg-transparent checked:border-primary checked:bg-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
									/>
									<svg
										class="pointer-events-none absolute top-1/2 left-0 size-5 -translate-y-1/2 p-1 text-text opacity-0 peer-checked:opacity-100"
										viewBox="0 0 16 16"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="m3 8.5 3.5 3.5L13 4.5"></path>
									</svg>
									<span class="text-sm leading-5 font-light text-text-inverse-muted">{copy.contact.form.consent}</span>
								</label>

								<div
									class="cf-turnstile col-span-full"
									data-sitekey={copy.contact.form.turnstileSiteKey}
									data-theme="dark"
								>
								</div>

								<div class="col-span-full flex items-center gap-4">
									<button
										type="submit"
										class="inline-flex cursor-pointer items-center justify-center rounded-[4px] bg-primary px-8 py-3 text-base leading-5 font-normal tracking-[0.02em] text-text transition duration-200 hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:shadow-[inset_0_4px_8px_var(--color-primary-active)] disabled:cursor-wait disabled:opacity-70"
									>
										{copy.contact.form.submit}
									</button>
									<span
										data-form-loader
										role="status"
										class="hidden size-6 animate-spin rounded-full border-2 border-border-strong border-t-primary motion-reduce:animate-none"
									>
									</span>
								</div>
							</form>

							<div
								data-form-success
								tabindex="-1"
								role="status"
								class="hidden text-xl leading-8 font-medium text-accent focus-visible:outline-none"
							>
								{copy.contact.form.success}
							</div>
							<div data-form-error role="alert" class="mt-4 hidden text-base leading-6 font-medium text-primary">
								{copy.contact.form.error}
							</div>
						</div>
					</div>

					<div
						class="group flex w-60 shrink-0 flex-col items-center rounded-[10px] bg-background px-6 py-8 text-center max-lg:w-full max-lg:max-w-60"
					>
						<div class="relative size-48 overflow-hidden rounded-full">
							<Image
								image={contactPerson.data.default_image}
								alt={contactPerson.data.default_image?.alt || contactPerson.data.title}
								sizes="12rem"
								loading="lazy"
								class="size-full object-cover"
							/>
							<Image
								image={contactPerson.data.hover_image}
								alt=""
								sizes="12rem"
								loading="lazy"
								class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100 motion-reduce:transition-none"
							/>
						</div>
						<p {...contactPerson.edit.title} class="mt-4 text-xl leading-[1.625rem] font-medium text-text">
							{contactPerson.data.title}
						</p>
						{
							contactPerson.data.position && (
								<p {...contactPerson.edit.position} class="mt-1 text-sm leading-5 font-light text-text">
									{contactPerson.data.position}
								</p>
							)
						}
					</div>
				</div>
			</div>
		</section>
		)
	}
</Base>

