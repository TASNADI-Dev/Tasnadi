	// Wires up the contact form: UTM hidden fields and Formspark submission with Turnstile.
	import { initUtmFields } from "../scripts/utm-fields";
	import { initFormsparkForms } from "../scripts/formspark-form";

	initUtmFields();
	initFormsparkForms();
</script>

<script>
	// Moves the spaceship toward the top left when scrolling down and back to the bottom right when scrolling up.
	const ship = document.querySelector<HTMLElement>("[data-spaceship]");
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	if (ship && ship.parentElement && !reduceMotion.matches) {
		const wrapper = ship.parentElement;
		const range = 12 * 16; // total travel in px (12rem) on each axis
		let ticking = false;

		const update = () => {
			const rect = wrapper.getBoundingClientRect();
			const viewport = window.innerHeight;
			const progress = Math.min(
				Math.max((viewport - rect.top) / (viewport + rect.height), 0),
				1,
			);
			const offset = (0.5 - progress) * range;
			ship.style.transform = `translate(${offset}px, ${offset}px)`;
			ticking = false;
		};

		window.addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
		update();
	}
</script>
