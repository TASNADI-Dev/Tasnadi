const stepColumn = ["lg:col-start-1", "lg:col-start-3", "lg:col-start-5", "lg:col-start-7"];
const arrowColumn = ["", "lg:col-start-2", "lg:col-start-4", "lg:col-start-6"];
const contactHref = localizePath("/contact", locale);
const whyIcons = ["clock", "arrow", "check"];
const planets = [
	{
		key: "ppc",
		src: "/method/planet-red.webp",
		size: 160,
		position: "top-0 -left-[15%] max-md:left-0",
		badgePosition: "top-[10%] -right-[10%]",
	},
	{
		key: "brand",
		src: "/method/planet-orange.webp",
		size: 163,
