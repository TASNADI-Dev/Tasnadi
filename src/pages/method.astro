---

<Base title={copy.pageTitle} navVariant="light">
	<section class="relative overflow-hidden bg-surface pt-[8.75rem] max-lg:pt-32">
		<img
			src="/method/hero-arc.svg"
			alt=""
			width="1512"
			height="158"
			loading="eager"
			class="pointer-events-none absolute bottom-0 left-1/2 h-auto w-[max(100%,64rem)] max-w-none -translate-x-1/2"
		/>

		<div class="relative z-10 mx-auto flex w-[92%] max-w-[76.875rem] flex-col items-center text-center">
			<p class="text-sm leading-5 font-normal text-text">{copy.label}</p>
			<h1 class="mt-3 max-w-[40rem] font-medium text-text text-display">{copy.title}</h1>
			<p class="mt-8 max-w-[44rem] text-2xl leading-9 font-normal text-text max-lg:text-xl max-lg:leading-8">
				{copy.text}
			</p>
			<h2 class="mt-16 max-w-[21rem] text-xl leading-[1.625rem] font-medium text-primary max-lg:mt-12">
				{copy.question}
			</h2>

			<VideoCard
				src={copy.video.src}
				poster="/global/images/service-video-poster.webp"
				playLabel={copy.video.playLabel}
				class="mt-10 shrink-0"
			/>
		</div>
	</section>

	<section class="overflow-x-clip pt-16 pb-[11.875rem] max-lg:pb-24">
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			<h2 class="mx-auto max-w-[46.25rem] text-center font-medium text-text text-heading">
				<span class="text-primary">{copy.process.titleHighlight}</span>{copy.process.titleRest}
			</h2>

			<div
				class="mt-8 grid gap-4 rounded-3xl border-2 border-accent bg-accent/10 p-10 lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] max-md:p-6"
			>
				{
					copy.process.steps.map((step, index) => (
						<>
							{index > 0 && (
								<div
									class:list={[
										"flex items-center justify-center max-lg:h-14 lg:row-start-1",
										arrowColumn[index],
									]}
									aria-hidden="true"
								>
									<svg
										width="48"
										height="16"
										viewBox="0 0 55 16"
										fill="none"
										class="h-4 w-12 text-accent max-lg:rotate-90"
									>
										<path
											fill-rule="evenodd"
											clip-rule="evenodd"
											d="M48.3431 0.92888L54.7071 7.29284C55.0976 7.68336 55.0976 8.31653 54.7071 8.70705L48.3431 15.071C47.9526 15.4615 47.3195 15.4615 46.9289 15.071C46.5384 14.6805 46.5384 14.0473 46.9289 13.6568L51.5858 8.99995H0V6.99995H51.5858L46.9289 2.34309C46.5384 1.95257 46.5384 1.3194 46.9289 0.92888C47.3195 0.538355 47.9526 0.538355 48.3431 0.92888Z"
											fill="currentColor"
										/>
									</svg>
								</div>
							)}
							<div
								class:list={[
									"flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 text-base leading-5 font-medium text-text uppercase lg:row-start-1",
									stepColumn[index],
								]}
							>
								{step.icon === "chat" && (
