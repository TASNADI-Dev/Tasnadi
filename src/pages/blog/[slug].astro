---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import type { CacheHint } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Badge from "../../components/Badge.astro";
import { loadCategories, translationGroupOf } from "../../utils/blog-posts";
import { resolveSiteIdentity } from "../../utils/site-identity";

const locale = Astro.currentLocale === "en" ? "en" : "hu";
const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

// A post is never shown in another language, so a missing English translation is a 404 instead of a Hungarian fallback
const { entry: post, cacheHint } = await getEmDashEntry("posts", slug, {
	locale,
	references: { category: true, author: true },
});

// EmDash falls back to the Hungarian entry when there is no translation, so the entry's own locale is checked too
if (!post || (post.data as { locale?: string }).locale !== locale) {
	return Astro.rewrite("/404");
}

const hints: CacheHint[] = [cacheHint];
const categories = await loadCategories(locale, hints);
if (Astro.cache?.enabled) hints.forEach((hint) => Astro.cache.set(hint));

const postCategory = post.references?.category.entries[0];
const categoryLabel =
	categories.find((item) => item.group === translationGroupOf(postCategory))?.label ?? postCategory?.data.title;
const author = post.references?.author.entries[0]?.data.title;
const date = post.data.publishedAt;

// Hungarian: 2025. február 12.
const dateFormatter = new Intl.DateTimeFormat(locale, {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "Europe/Budapest",
});

// Styles for the rich text coming from the CMS, which cannot carry classes of its own
const contentClass = [
	"text-base leading-[1.75rem] font-light text-text-muted",
	"[--emdash-caption-color:var(--color-text-muted)]",
	"[&>:first-child]:mt-0",
	"[&_p]:my-5",
	"[&_strong]:font-bold [&_strong]:text-text",
	"[&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors [&_a]:duration-200 hover:[&_a]:text-primary motion-reduce:[&_a]:transition-none",
	"[&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:text-[1.75rem] [&_h2]:leading-9 [&_h2]:font-medium [&_h2]:text-text max-lg:[&_h2]:text-2xl max-lg:[&_h2]:leading-8",
	"[&_h3]:mt-10 [&_h3]:mb-3 [&_h3]:text-[1.375rem] [&_h3]:leading-8 [&_h3]:font-medium [&_h3]:text-text max-lg:[&_h3]:text-xl max-lg:[&_h3]:leading-7",
	"[&_h4]:mt-8 [&_h4]:mb-3 [&_h4]:text-lg [&_h4]:leading-7 [&_h4]:font-medium [&_h4]:text-text",
	"[&_h5]:mt-8 [&_h5]:mb-3 [&_h5]:text-base [&_h5]:font-medium [&_h5]:text-text",
	"[&_h6]:mt-8 [&_h6]:mb-3 [&_h6]:text-base [&_h6]:font-medium [&_h6]:text-text",
	"[&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:my-5 [&_ol]:list-decimal [&_ol]:pl-6",
	"[&_li]:my-2 [&_li]:pl-1 [&_li_ul]:my-2 [&_li_ol]:my-2 [&_li::marker]:text-text",
	"[&_blockquote]:my-8 [&_blockquote]:border-l-4 [&_blockquote]:border-accent [&_blockquote]:pl-6 [&_blockquote]:text-lg [&_blockquote]:leading-8 [&_blockquote]:font-medium [&_blockquote]:text-text",
	"[&_img]:rounded-[20px]",
];

const { siteTitle } = resolveSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? post.data.post_summary}
	canonical={seo.canonical}
	content={{ collection: "posts", id: post.data.id, slug }}
	navVariant="dark"
>
	<section class="bg-background pt-[11.25rem] pb-12 max-lg:pt-40 max-lg:pb-10">
		<div
			class="mx-auto grid w-[92%] max-w-[76.875rem] items-center gap-12 lg:grid-cols-2 lg:gap-16 max-lg:gap-8"
		>
			<div class="flex flex-col items-start gap-5">
				{categoryLabel && <Badge variant="solid">{categoryLabel}</Badge>}
				<h1
					class="text-[2.5rem] leading-[3rem] font-medium tracking-[-0.02em] max-lg:text-[1.75rem] max-lg:leading-[2.25rem]"
				>
					{post.data.title}
				</h1>
				{
					post.data.post_summary && (
						<p class="text-base leading-[1.625rem] font-medium text-text-muted">{post.data.post_summary}</p>
					)
				}
			</div>

			{
				post.data.image && (
					<Image
						image={post.data.image}
						sizes="(min-width: 64rem) 37rem, 92vw"
						loading="eager"
						fetchpriority="high"
						class="h-auto w-full rounded-[20px] max-lg:order-first"
					/>
				)
			}
		</div>
	</section>

	<section class="bg-background pb-20 max-lg:pb-14">
		<div
			data-reading-progress
			aria-hidden="true"
			class="pointer-events-none fixed inset-x-0 top-0 z-110 h-1 origin-left bg-accent [transform:scaleX(var(--progress,0))]"
		>
		</div>

		<div class="mx-auto w-[92%] max-w-[50rem]">
			{
				(author || date) && (
					<p class="mb-8 flex flex-wrap items-center gap-x-3 text-sm leading-5 font-medium text-text-muted uppercase">
						{author && <span>{author}</span>}
						{author && date && <span aria-hidden="true" class="h-4 w-0.5 bg-accent" />}
						{date && <time datetime={date.toISOString()}>{dateFormatter.format(date)}</time>}
					</p>
				)
			}

			<div data-reading-content class:list={contentClass}>
				<PortableText value={post.data.content} />
			</div>
		</div>
	</section>
</Base>

<script>
	// Fills the fixed reading progress bar as the reader scrolls through the post content.
	const bar = document.querySelector<HTMLElement>("[data-reading-progress]");
	const content = document.querySelector<HTMLElement>("[data-reading-content]");

	if (bar && content) {
		let frame = 0;

		const update = () => {
			frame = 0;
			const { top, height } = content.getBoundingClientRect();
			const scrollable = Math.max(height - window.innerHeight, 1);
			const progress = Math.min(Math.max(-top / scrollable, 0), 1);
			bar.style.setProperty("--progress", String(progress));
		};
		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(update);
		};

		window.addEventListener("scroll", schedule, { passive: true });
		window.addEventListener("resize", schedule);
		update();
	}
</script>
