---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import ClutchReviews from "../../components/ClutchReviews.astro";
import CtaBox from "../../components/CtaBox.astro";
import ProcessTimeline from "../../components/ProcessTimeline.astro";
import ServicePackage from "../../components/ServicePackage.astro";
import VideoCard from "../../components/VideoCard.astro";

const locale = Astro.currentLocale === "en" ? "en" : "hu";

const copy = {
	hu: {
		pageTitle: "Weboldal tanácsadás",
		title: "Tanácsadás",
		text: "Segítünk a megfelelő stratégia kidolgozásában, hogy kitűnj a piacon.",
		video: { src: "/services/consulting/intro-hu.mp4", playLabel: "Videó lejátszása" },
		pain: {
			title: "Készen állsz",
			titleHighlight: "online jelenléted",
			titleEnd: "átalakítására?",
			items: [
				"Nem tudod, hogyan határozhatod meg hatékonyan a célpiacod, vagy hogyan érheted el ideális ügyfeleidet?",
				"Nehezen tudod megfogalmazni egyedi értékesítési ajánlataidat, amelyek megkülönböztetnek téged a versenytársaktól?",
				"Kihívást jelent weboldalad optimalizálása a konverziók és az eladások hatékony növelése érdekében?",
				"Talán nincs is honlapstratégiád?",
			],
		},
		great: {
			title: "„Hogyan készítsünk weboldalt?” –",
			titleHighlight: "kérdezheted.",
			text: "A website készítés tanácsadás pontosan erről szól: egy külső, szakértői nézőpontot adunk. Segítünk strukturáltan gondolkodni márkádról és weboldaladról, és konkrét lépéseket kínálunk, amelyekkel a vállalkozásodnak legmegfelelőbb weboldalt hozhatod létre.",
			items: [
				"Megvizsgáljuk célközönségedet és üzleti igényeidet.",
				"Egyesítjük erőinket, hogy strukturáljuk meglévő tudásodat.",
				"Elemezzük meglévő weboldaladat, és meghatározzuk a fejlesztendő területeket.",
				"Útitervet készítünk a designhoz, és megalkotjuk ideális weboldaladat.",
			],
		},
		process: {
			title: "Folyamatunk",
			text: "Website vagy webáruház tanácsadás terén sikeredre egyszerűsített folyamatunk a garancia: kevesebb stresszt jelent neked, és jobb eredményeket vállalkozásodnak.",
			timelineLabel: "Tanácsadás folyamata hétről hétre",
			week: (week: string) => `${week}. hét`,
			phases: ["Stratégia"],
			steps: [
				["Információgyűjtés", "Beszélgetés az érintettekkel, workshopok szervezése és ügyfélinterjúk lefolytatása."],
				["Website audit", "Elemezzük meglévő weboldaladat, és meghatározzuk a fejlesztendő területeket."],
				["Márkapozicionálás workshop", "Számba vesszük a márkád szubjektív és objektív meghatározóit, úgymint értékek, személyiség és célközönség."],
				["Funkció & tartalom workshop", "Elemezzük ügyfeleid különböző igényeit, frusztrációit, és azt, hogy hogyan fogják használni weboldaladat."],
				["Sitemap", "Megtervezzük weboldalad ideális elrendezését."],
			],
		},
		expect: {
			title: "Mire számíthatok?",
			items: [
				{
					title: "Egyediséged világos megértése",
					text: "Fantasztikus vagy abban, amit csinálsz, ehhez kétség sem férhet. De azt is tudod, hogyan kommunikáld ezt? Meglepő módon a legtöbb vállalat nem tudja. Hogy kiderítsük, beszélünk a kollégáiddal és az ügyfeleiddel, és végzünk némi piackutatást is. A Márkastratégiában rögzítjük mindezt.",
				},
				{
					title: "Szakértői betekintés jelenlegi weboldaladba",
					text: "A jelenlegi weboldal vagy webshop elemzésével és az analitikai adatok vizsgálatával egy listát tudunk adni arról, hogy mit kell tenned a konverziós arányok javítása érdekében. Ezeket egy hatás-ráfordítás mátrixba rendezzük, hogy megalapozott döntést hozhass, és rangsorolhasd a feladatokat.",
				},
				{
					title: "Akcióterv egy nagyszerű weboldal létrehozásához",
					text: "A weboldal készítés tanácsadás végén nem kötelező megbíznod minket, hogy elkészítsük a weboldalad, mi így is egy használható tervvel tudunk szolgálni számodra. Betekintést és tervezetet nyújtunk az ideális weboldal megalkotásához, amely leadekkel vagy eladásokkal támogatja vállalkozásodat.",
				},
			],
		},
		packages: {
			title: "Szolgáltatásaink",
			text: "A weboldal készítés vagy a webshop készítés tanácsadás nálunk egy kézzelfogható folyamatot jelent: a stratégiaalkotástól és a meglévő oldalad auditálásától kezdve egészen a részletes oldaltérképig vezetünk – legyen szó akár egy céges bemutatkozó oldalról, akár egy komplex webáruházról.",
			items: ["Start Meeting", "Website audit", "Márkapozicionálás workshop", "Funkció & tartalom workshop", "Sitemap"],
			cards: ["Website audit", "Weboldal stratégia"],
			cta: "Ajánlatot kérek",
		},
		why: {
			title: "Miért érdemes",
			titleHighlight: "velünk",
			titleEnd: "együttműködni?",
			items: [
				{
					title: "Zökkenőmentes munka, jobb eredmények",
					text: "Egyszerűsített folyamatunk kevesebb stresszt jelent neked, vállalkozásod számára pedig jobb eredményeket. Lehetővé tesszük, hogy a márkád felvirágoztatására koncentrálhass.",
				},
				{
					title: "Konverzióközpontú tervezés",
					text: "A digitális értékesítési eszközöket a közönségedre szabjuk, növelve ezzel az elköteleződést és a bevételt. Stratégiai megközelítésünk biztosítja, hogy webhelyed értékes eszköz legyen vállalkozásod számára.",
				},
				{
					title: "Hosszú távú partnerségek",
					text: "Többek vagyunk, mint pusztán a tervezőid – a szövetségeseid vagyunk a növekedésedben, az előttünk álló úton. A sikeredet tartva elsődleges célunknak együtt navigálunk az örökké fejlődő-változó piacon, és folyamatos támogatást nyújtunk vállalkozásod virágzásához.",
				},
			],
		},
		cta: {
			title: "Érdekel a szolgáltatásunk?",
			text: "Jelentkezz egy ingyenes konzultációra, ahol felmérjük az elakadásaid, üzleti céljaid, és meghatározzuk a stratégiai lehetőségeket!",
			buttonLabel: "Ajánlatot kérek",
		},
	},
	en: {
		pageTitle: "Website consulting",
		title: "Consulting",
		text: "We help you create a strategy for standing out in your market.",
		video: { src: "/services/consulting/intro-en.mp4", playLabel: "Play video" },
		pain: {
			title: "Ready to transform your",
			titleHighlight: "online presence?",
			titleEnd: "",
			items: [
				"Are you unsure about how to effectively define your target market or reach your ideal customers?",
				"Are you struggling to articulate your unique selling propositions that set you apart from competitors?",
				"Are you finding it challenging to optimize your website to drive conversions and increase sales effectively?",
				"Do you not have a website strategy at all?",
			],
		},
		great: {
			title: "“How do we create a great website?”",
			titleHighlight: "you might ask.",
			text: "Our website creation consulting is about providing exactly that: an external, expert perspective. We help you think about your brand and website in a structured way and provide specific steps you can take to build the best website for your business.",
			items: [
				"We investigate your target audience and business needs.",
				"We join forces to organize your existing knowledge.",
				"We analyze your existing website and identify areas for improvement.",
				"We create a roadmap to design & build your ideal website.",
			],
		},
		process: {
			title: "Our process",
			text: "Our streamlined process is your guarantee for success: less stress for you and better results for your business.",
			timelineLabel: "Consulting process week by week",
			week: (week: string) => `Week ${week}`,
			phases: ["Strategy"],
			steps: [
				["Collecting information", "Speaking with the relevant stakeholders, organizing workshops, and conducting customer interviews."],
				["Website audit", "We analyze your existing website and identify areas for improvement."],
				["Brand positioning workshop", "We take stock of the subjective and objective characteristics that define your brand, such as values, personality, and target audience."],
				["Function & content workshop", "We analyze your customers’ different needs, frustrations, and how they are about to use your website."],
				["Sitemap", "We design the ideal layout for your website."],
			],
		},
		expect: {
			title: "What to expect?",
			items: [
				{
					title: "A clear understanding of what makes you unique",
					text: "You’re awesome at what you do; there's no doubt about it. But do you know how to communicate that? Surprisingly, most companies don’t. We speak to your relevant colleagues and clients to find out, and we do some market research. Then we lay it out in your Brand Strategy.",
				},
				{
					title: "Expert insights into your current website",
					text: "By analyzing your current website or webshop and looking into analytics data, we can provide you with a list of things to do to improve conversion rates. We’ll neatly organize them in an impact-effort matrix, so you can make an informed decision and prioritize tasks.",
				},
				{
					title: "An action plan for building a great website",
					text: "At the end of our website creation consulting, you don’t have to hire us to build your website; we will still provide you with an actionable plan. We’ll give you insights and a blueprint for building your ideal website, which will support your business by generating leads or sales.",
				},
			],
		},
		packages: {
			title: "Our services",
			text: "For us, website or e-commerce creation consulting is a tangible process. We guide you from the initial strategy and audit of your existing site all the way to a detailed sitemap – whether you need a corporate introductory page or a complex e-commerce store.",
			items: ["Start meeting", "Website audit", "Brand positioning workshop", "Function & content workshop", "Sitemap"],
			cards: ["Website audit", "Website strategy"],
			cta: "Sounds interesting; let’s chat!",
		},
		why: {
			title: "Why partner",
			titleHighlight: "with us?",
			titleEnd: "",
			items: [
				{
					title: "Smooth journey, better results",
					text: "Our streamlined process means less stress for you and better results for your business. We keep it simple, so you can focus on growing your brand.",
				},
				{
					title: "Conversion-centric design",
					text: "We tailor digital sales tools to your audience, boosting engagement and revenue. Our strategic approach ensures your website is a valuable asset for your business.",
				},
				{
					title: "Long-term partnerships",
					text: "We're more than just your designers; we're your growth allies for the journey ahead. With your success as our priority, we navigate the evolving market together, offering ongoing support to ensure your business continues to thrive.",
				},
			],
		},
		cta: {
			title: "Interested?",
			text: "Let’s have a conversation and see how we can help boost your brand.",
			buttonLabel: "Sounds interesting; let’s chat!",
		},
	},
}[locale];

const packageIncluded = [
	[true, true, false, false, false],
	[true, true, true, true, true],
] as const;

const packages = copy.packages.cards.map((title, index) => ({
	title,
	items: copy.packages.items.map((label, itemIndex) => ({ label, included: packageIncluded[index][itemIndex] })),
}));

const weeks = Array.from({ length: 8 }, (_, index) => copy.process.week(String(index + 1).padStart(2, "0")));

const phases = [{ span: 8, tone: 1 }] as const;

const stepLayout = [
	{ tone: 1, column: 1, span: 2, row: 1 },
	{ tone: 1, column: 3, span: 1, row: 2 },
	{ tone: 1, column: 4, span: 2, row: 3 },
	{ tone: 1, column: 6, span: 2, row: 4 },
	{ tone: 1, column: 8, span: 1, row: 5 },
] as const;

const contactHref = getRelativeLocaleUrl(locale, "/contact").replace(/(.)\/$/, "$1");
---

<Base title={copy.pageTitle}>
	<section class="bg-background pt-[8.75rem] max-lg:pt-32">
		<div
			class="mx-auto flex w-[92%] max-w-[76.875rem] items-start justify-between gap-x-12 gap-y-10 max-lg:flex-col"
		>
			<div class="max-w-[39rem]">
				<h1 class="font-medium text-text text-display">
					{copy.title}
				</h1>
				<p class="mt-4 text-2xl leading-9 font-normal text-text max-lg:text-xl max-lg:leading-8">
					{copy.text}
				</p>
			</div>

			<VideoCard
				src={copy.video.src}
				poster="/global/images/service-video-poster.webp"
				playLabel={copy.video.playLabel}
				class="shrink-0"
			/>
		</div>
	</section>

	<section class="bg-background pt-10 pb-[7.5rem] max-lg:pb-20">
		<div class="relative mx-auto w-[92%] max-w-[76.875rem]">
			<img
				src="/global/images/service-shape.webp"
				alt=""
				width="1512"
				height="400"
				loading="lazy"
				class="pointer-events-none absolute top-[12.75rem] left-1/2 h-auto w-[min(80rem,100vw)] max-w-none -translate-x-1/2 max-md:hidden"
			/>

			<div class="relative flex flex-col items-center text-center">
				<img
					src="/global/images/service-planet.webp"
					alt=""
					width="83"
					height="83"
					loading="lazy"
					class="mb-5 size-[2.625rem]"
				/>
				<h2 class="max-w-[44rem] font-medium text-text text-heading">
					{copy.pain.title} <span class="text-primary">{copy.pain.titleHighlight}</span>
					{copy.pain.titleEnd && ` ${copy.pain.titleEnd}`}
				</h2>

				<ul
					class="mt-10 grid w-full max-w-[60.625rem] grid-cols-4 gap-6 max-lg:grid-cols-2 max-md:grid-cols-1"
				>
					{
						copy.pain.items.map((item) => (
							<li class="flex min-h-[13.375rem] items-center justify-center rounded-[20px] bg-background px-4 py-6 text-center text-base leading-6 font-normal text-text shadow-[0_4px_4px_color-mix(in_srgb,var(--color-shadow)_10%,transparent),0_10px_25px_color-mix(in_srgb,var(--color-shadow)_20%,transparent)] max-md:min-h-0">
								{item}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section class="bg-background pb-24 max-lg:pb-16">
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			<div class="text-center">
				<h2 class="mx-auto max-w-[56.5rem] font-medium text-text text-heading">
					{copy.great.title} <span class="text-primary">{copy.great.titleHighlight}</span>
				</h2>
				<p class="mx-auto mt-6 max-w-[40rem] text-base leading-[1.625rem] font-light text-text">
					{copy.great.text}
				</p>
			</div>

			<ul
				class="mx-auto mt-16 grid max-w-[53rem] grid-cols-2 gap-x-16 gap-y-10 max-lg:mt-10 max-lg:gap-x-8 max-md:grid-cols-1"
			>
				{
					copy.great.items.map((item) => (
						<li class="flex gap-3">
							<img
								src="/global/images/star-icon.webp"
								alt=""
								width="26"
								height="26"
								loading="lazy"
								class="size-[1.625rem] shrink-0"
							/>
							<p class="text-xl leading-[1.625rem] font-medium text-text">{item}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section
		class="bg-surface-dark bg-[url(/global/images/service-process-bg.png)] bg-contain bg-[position:50%_0] bg-no-repeat pt-[8.75rem] max-lg:pb-6 max-md:pt-[6.25rem]"
	>
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			<div class="max-w-[26.375rem]">
				<h2 class="font-medium text-text-inverse text-heading">{copy.process.title}</h2>
				<p class="mt-6 text-base leading-[1.625rem] font-light text-text-inverse">{copy.process.text}</p>
			</div>
		</div>

		<ProcessTimeline
			label={copy.process.timelineLabel}
			fitContent
			weeks={weeks}
			phases={phases.map((phase, index) => ({ ...phase, label: copy.process.phases[index] }))}
			steps={stepLayout.map((layout, index) => ({
				...layout,
				title: copy.process.steps[index][0],
				text: copy.process.steps[index][1],
			}))}
			class="mt-[4.125rem]"
		/>
	</section>

	<section class="relative overflow-hidden bg-surface-dark pt-[5.25rem] pb-80">
		<div class="relative z-10 mx-auto w-[92%] max-w-[76.875rem]">
			<h2 class="mx-auto max-w-[56.5625rem] text-center font-medium text-text-inverse text-heading">
				{copy.expect.title}
			</h2>

			<ul class="mx-auto mt-[4.625rem] grid max-w-[69.25rem] grid-cols-3 gap-8 max-md:grid-cols-1">
				{
					copy.expect.items.map((item) => (
						<li class="flex items-start gap-3">
							<svg
								viewBox="0 0 42 42"
								fill="none"
								aria-hidden="true"
								class="mt-1 size-[2.625rem] shrink-0 text-primary"
							>
								<circle cx="21" cy="21" r="20" stroke="currentColor" stroke-width="2" />
								<path
									d="M31.1957 18.9987L27.6478 15.2812C27.5626 15.1921 27.4612 15.1214 27.3494 15.0731C27.2377 15.0249 27.1179 15 26.9969 15C26.8758 15 26.756 15.0249 26.6443 15.0731C26.5326 15.1214 26.4312 15.1921 26.346 15.2812C26.1752 15.4594 26.0794 15.7003 26.0794 15.9515C26.0794 16.2027 26.1752 16.4437 26.346 16.6218L29.6097 20.035L10.9168 20.035C10.6736 20.035 10.4404 20.1352 10.2685 20.3135C10.0966 20.4918 10 20.7336 10 20.9857C10 21.2379 10.0966 21.4797 10.2685 21.658C10.4404 21.8363 10.6736 21.9365 10.9168 21.9365L29.6647 21.9365L26.346 25.3687C26.26 25.4571 26.1918 25.5622 26.1453 25.6781C26.0987 25.794 26.0748 25.9182 26.0748 26.0437C26.0748 26.1692 26.0987 26.2935 26.1453 26.4094C26.1918 26.5252 26.26 26.6304 26.346 26.7188C26.4312 26.8079 26.5326 26.8786 26.6443 26.9269C26.756 26.9751 26.8758 27 26.9969 27C27.1179 27 27.2377 26.9751 27.3494 26.9269C27.4612 26.8786 27.5625 26.8079 27.6478 26.7188L31.1957 23.0299C31.7107 22.4951 32 21.7701 32 21.0143C32 20.2584 31.7107 19.5335 31.1957 18.9987Z"
									fill="currentColor"
								/>
							</svg>
							<div>
								<h3 class="mt-2.5 text-2xl leading-[2.125rem] font-medium text-text-inverse">{item.title}</h3>
								<p class="mt-[1.125rem] mb-2.5 text-base leading-[1.625rem] font-light text-text-inverse">{item.text}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>

		<img
			src="/global/images/service-astronaut.webp"
			alt=""
			width="627"
			height="383"
			loading="lazy"
			class="pointer-events-none absolute bottom-0 left-0 h-auto w-[39.1875rem] max-w-full"
		/>
	</section>

	<section class="bg-background pt-24 pb-24 max-lg:py-16">
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			<h2 class="text-center font-medium text-text text-heading">{copy.packages.title}</h2>
			<p class="mx-auto mt-6 max-w-[40rem] text-center text-base leading-[1.625rem] font-light text-text">
				{copy.packages.text}
			</p>

			<div class="mx-auto mt-16 grid max-w-[37.6875rem] grid-cols-2 gap-[2.1875rem] max-lg:gap-6 max-md:mt-10 max-md:grid-cols-1">
				{packages.map((pkg) => <ServicePackage title={pkg.title} items={pkg.items} />)}
			</div>

			<div class="mt-16 flex justify-center max-md:mt-10">
				<Button variant="link-arrow" href={contactHref}>
					{copy.packages.cta}
				</Button>
			</div>
		</div>
	</section>

	<section class="flow-root bg-surface pb-24 max-lg:pb-16 [&_.clutch-widget]:overflow-hidden [&_.clutch-widget]:rounded-[20px]">
		<div class="mx-auto w-[92%]">
			<ClutchReviews />
		</div>
	</section>

	<section class="bg-surface pb-16">
		<div class="mx-auto w-[92%] max-w-[63.4375rem]">
			<h2 class="text-center font-medium text-text text-heading">
				{copy.why.title} <span class="text-primary">{copy.why.titleHighlight}</span>
				{copy.why.titleEnd && ` ${copy.why.titleEnd}`}
			</h2>

			<ul class="mt-16 grid grid-cols-3 gap-6 max-md:mt-10 max-md:grid-cols-1">
				{
					copy.why.items.map((item) => (
						<li class="flex items-start gap-3">
							<img
								src="/global/images/star-icon.webp"
								alt=""
								width="26"
								height="26"
								loading="lazy"
								class="size-[1.625rem] shrink-0"
							/>
							<div>
								<h3 class="text-xl leading-[1.625rem] font-medium text-text">{item.title}</h3>
								<p class="mt-2 text-base leading-[1.625rem] font-light text-text-muted">{item.text}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="bg-surface py-10">
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			<CtaBox
				title={copy.cta.title}
				text={copy.cta.text}
				buttonLabel={copy.cta.buttonLabel}
				buttonHref={contactHref}
			/>
		</div>
	</section>
</Base>
