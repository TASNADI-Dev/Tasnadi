---
import { localizePath } from "../../../i18n/routes";
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ClutchReviews from "../../../components/ClutchReviews.astro";
import CtaBox from "../../../components/CtaBox.astro";
import HeroShapes from "../../../components/HeroShapes.astro";
import PersonBioCard from "../../../components/PersonBioCard.astro";
import ProcessStepCard from "../../../components/ProcessStepCard.astro";

const locale = Astro.currentLocale === "en" ? "en" : "hu";

const copy = {
	hu: {
		pageTitle: "UX/UI tervezés – Javítsd a felhasználói élményt!",
		breadcrumbs: ["Szolgáltatásaink", "Weboldalak"],
		title: "UX / UI tervezés",
		subtitle: "Javítsd velünk a felhasználói élményt!",
		lead: "A felhasználói élmény kulcsfontosságú szerepet játszik abban, hogy a látogatók hosszú távon elköteleződjenek a weboldalad mellett.",
		meaning: {
			title: "UX/UI design – mikor van rá szükséged?",
			text: "A UX/UI tervezés akkor válik szükségessé, amikor a weboldalad vagy alkalmazásod használata nem elég intuitív, vagy ha a felhasználói élmény nem éri el a kívánt szintet. Egy jól megtervezett felület segít abban, hogy a látogatók gyorsan és könnyedén megtalálják, amit keresnek, ezzel növelve a weboldal vagy alkalmazás hatékonyságát.",
		},
		asYouWish: {
			title: "Weblap készítés,",
			titleHighlight: "ahogy szeretnéd",
			blocks: [
				{
					number: "01",
					title: "Kinek ajánljuk a szolgáltatást?",
					paragraphs: [
						{
							lead: "Bármilyen vállalkozásról legyen szó, a UX/UI design mindenki számára hasznos, aki szeretné, hogy az online felületei egyszerűen kezelhetők legyenek.",
							text: "Ha a weboldalad, alkalmazásod vagy platformod felhasználói élménye nem felel meg az elvárásoknak, mi segítünk ennek javításában.",
						},
						{
							lead: "A felhasználói élmény fontossága:",
							text: "A user interface (UI) és a user experience (UX) elengedhetetlenek a weboldalak vagy alkalmazások sikeréhez. A UI az, amit a felhasználó lát, az UX pedig az élmény, amit használat során tapasztal. Ezek a tényezők határozzák meg, hogy a felhasználó mennyire elégedett a szolgáltatással, és hogy visszatér-e a jövőben.",
						},
					],
				},
				{
					number: "02",
					title: "Miben segít egy UI/UX designer?",
					paragraphs: [
						{
							lead: "A UI/UX designer feladata, hogy olyan felhasználói felületet alkosson, amely könnyen navigálható és esztétikailag vonzó,",
							text: "ugyanakkor azt is biztosítja, hogy a felhasználók könnyen elérjék a kívánt céljaikat.",
						},
					],
				},
			],
		},
		meaningForUs: {
			title: "Mit jelent számunkra a UX/UI?",
			items: [
				"Számunkra a UX/UI design nem csupán a felület megtervezését jelenti, hanem az egész felhasználói élmény átgondolt kialakítását.",
				"Célunk, hogy olyan élményt nyújtsunk a látogatók számára, amely megkönnyíti a felhasználók számára a céljaik elérését.",
				"A UX/UI számunkra a felhasználóval való interakció optimalizálása, esztétikai vonzerejének növelése, és a funkcionalitás biztosítása.",
			],
		},
		workWithUs: {
			title: "Dolgozz velünk",
			text: "Jelentkezz konzultációra és lendítsük fel együtt az online jelenléted.",
			buttonLabel: "Jelentkezem konzultációra",
		},
		process: {
			title: "Hogyan dolgozunk",
			text: "Mi egy átlátható és strukturált folyamatot követünk a UX/UI design megtervezése során. A folyamatunk az alábbi lépésekből áll:",
			steps: [
				["01 Igényfelmérés, tervezés", "Megismerkedünk a céljaiddal, elvárásaiddal, és felmérjük a projekt igényeit."],
				["02 Felhasználói kutatás és versenytárs elemzés", "Felmérjük a célközönséged igényeit, hogy a tervezett felület minden szempontból megfeleljen nekik, valamint figyelembe vesszük versenytársaidat is."],
				["03 Wireframe-ek elkészítése", "Vázlatot készítünk a tervezett struktúráról és elrendezésről."],
				["04 Design fejlesztése", "Elkészítjük a végleges designt, figyelembe véve a te igényeidet."],
				["05 Tesztelés és finomítás", "A tervezett felületet teszteljük, és ha finomításra van szükség, természetesen változtatunk."],
				["06 Kivitelezés és átadás", "A végleges tervek alapján megvalósítjuk a felületet, és átadjuk a kész terméket."],
			],
		},
		pricing: {
			title: "UI/UX tervezés árak –",
			titleHighlight: "mi alapján árazunk?",
			items: [
				"Az árakat a projekt komplexitása, a kívánt funkciók és a testre szabott igények határozzák meg.",
				"Mivel minden ügyfelünk egyedi igényekkel rendelkezik, ezért minden projektet egyedi árajánlattal közelítünk meg.",
			],
		},
		cta: {
			title: "Érdekel szolgáltatásunk?",
			text: "Jelentkezz egy ingyenes, kötelezettségmentes beszélgetésre, és derítsük ki, hogy tudunk-e neked segíteni, és tényleg mi vagyunk-e a legmegfelelőbb választás számodra. A jelentkezésed után 3 munkanapon belül felvesszük veled a kapcsolatot!",
			buttonLabel: "Jelentkezem konzultációra",
		},
	},
	en: {
		pageTitle: "UX/UI design – Improve the user experience!",
		breadcrumbs: ["Services", "Websites"],
		title: "UX / UI design",
		subtitle: "Improve user experience with us!",
		lead: "User experience plays a key role in keeping visitors engaged with your website over the long term.",
		meaning: {
			title: "UX/UI design – when do you need it?",
			text: "UX/UI design becomes essential when your website or application isn’t intuitive enough, or when the user experience doesn’t meet expectations. A well-designed interface helps visitors quickly and easily find what they’re looking for – boosting the efficiency and overall performance of your website or app.",
		},
		asYouWish: {
			title: "Web design",
			titleHighlight: "the way you want it",
			blocks: [
				{
					number: "01",
					title: "Who is this service for?",
					paragraphs: [
						{
							lead: "UX/UI design is valuable for any business that wants to ensure its digital platforms are easy to use.",
							text: "If your website, application, or online platform isn’t meeting usability expectations, we’re here to help improve it.",
						},
						{
							lead: "The importance of user experience:",
							text: "User interface (UI) and user experience (UX) are critical to the success of any website or application. UI is what users see, while UX is the experience they have during interaction. These elements determine how satisfied users are – and whether they’ll return in the future.",
						},
					],
				},
				{
					number: "02",
					title: "What does a UI/UX designer do?",
					paragraphs: [
						{
							lead: "A UI/UX designer creates interfaces that are both easy to navigate and visually appealing,",
							text: "while also ensuring users can reach their goals effortlessly. It’s about combining aesthetics with functionality for a seamless experience.",
						},
					],
				},
			],
		},
		meaningForUs: {
			title: "What UX/UI means to us",
			items: [
				"For us, UX/UI design goes far beyond just creating a nice-looking interface. It’s about designing an entire experience with intention and clarity.",
				"Our goal is to make it easier for users to achieve their goals, while optimizing their interaction with your platform.",
				"UX/UI, for us, means maximizing usability, enhancing visual appeal, and ensuring everything works smoothly.",
			],
		},
		workWithUs: {
			title: "Work with us",
			text: "Book a consultation and let’s elevate your online presence – together.",
			buttonLabel: "Book consultation",
		},
		process: {
			title: "How we work",
			text: "We follow a clear, structured process to deliver high-quality UX/UI design. Here’s how our workflow looks:",
			steps: [
				["01 Initial consultation", "We get to know your goals and expectations and assess the needs of the project."],
				["02 User research & competitor analysis", "We analyze your target audience’s needs to design a user-friendly interface, while considering your competitors as well."],
				["03 Wireframing", "We create layout sketches to map out the structure and flow."],
				["04 Design development", "Based on your input, we create the final designs with attention to every detail."],
				["05 Testing & refinement", "We test the interface, and make adjustments where necessary to ensure it meets both your and your users’ needs."],
				["06 Implementation & handover", "We bring the design to life and deliver the completed product to you."],
			],
		},
		pricing: {
			title: "UI/UX design pricing –",
			titleHighlight: "how do we price our work?",
			items: [
				"Our pricing depends on the complexity of the project, desired features, and level of customization.",
				"Since each project is unique, we always provide a personalized quote based on your specific requirements.",
			],
		},
		cta: {
			title: "Ready to level up?",
			text: "Book a free, no-pressure call with us. Let’s find out if we’re the perfect match. After you sign up, we’ll get back to you within three business days!",
			buttonLabel: "Book consultation",
		},
	},
}[locale];

const contactHref = localizePath("/contact", locale);

const breadcrumbs = [
	{ label: copy.breadcrumbs[0], href: localizePath("/services", locale) },
	{ label: copy.breadcrumbs[1], href: localizePath("/services/website", locale) },
	{ label: copy.title },
];

const stepTones = [1, 1, 2, 2, 3, 3] as const;
---

<Base title={copy.pageTitle}>
	<section class="bg-background pt-[8.75rem] pb-16 max-lg:pt-32 max-lg:pb-10">
		<div
			class="mx-auto flex w-[92%] max-w-[76.875rem] items-start justify-between gap-x-12 gap-y-10 max-lg:flex-col"
		>
			<div class="max-w-[39rem]">
				<Breadcrumbs items={breadcrumbs} class="mb-6" />
				<h1 class="font-medium text-text text-display">{copy.title}</h1>
				<p class="mt-6 text-3xl leading-10 font-normal text-text max-lg:text-2xl max-lg:leading-9">
					{copy.subtitle}
				</p>
				<p class="mt-4 max-w-[34rem] text-xl leading-8 font-light text-text">{copy.lead}</p>
			</div>

			<div class="relative w-full max-w-[19.5rem] shrink-0 max-lg:max-w-[24rem]">
				<HeroShapes />
				<PersonBioCard personSlug="marci-fekete" />
			</div>
		</div>
	</section>

	<section class="relative overflow-hidden bg-background pt-24 pb-24 max-lg:py-16">
		<img
			src="/global/images/service-shape.webp"
			alt=""
			width="1512"
			height="400"
			loading="lazy"
			class="pointer-events-none absolute bottom-6 left-1/2 h-auto w-[min(80rem,100vw)] max-w-none -translate-x-1/2 max-md:hidden"
		/>
		<div class="relative mx-auto flex w-[92%] max-w-[76.875rem] flex-col items-center text-center">
			<h2 class="max-w-[37.375rem] font-medium text-text text-heading">{copy.meaning.title}</h2>
			<p
				class="mt-10 max-w-[28rem] rounded-[20px] bg-background px-8 py-6 text-base leading-[1.625rem] font-light text-text shadow-[0_0.5rem_1.5rem_color-mix(in_srgb,var(--color-shadow)_15%,transparent)]"
			>
				{copy.meaning.text}
			</p>
		</div>
	</section>

	<section class="bg-background pb-24 max-lg:pb-16">
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			<h2 class="mx-auto max-w-[37.375rem] text-center font-medium text-text text-heading">
				{copy.asYouWish.title} <span class="text-primary">{copy.asYouWish.titleHighlight}</span>
			</h2>

			<div class="mt-16 flex flex-col gap-16 max-md:mt-10 max-md:gap-12">
				{
					copy.asYouWish.blocks.map((block) => (
						<div class="grid grid-cols-2 items-start gap-x-16 gap-y-6 max-lg:grid-cols-1">
							<h3 class="max-w-[30rem] text-3xl leading-10 font-medium text-text max-lg:text-2xl max-lg:leading-9">
								<span class="text-primary">{block.number}</span> {block.title}
							</h3>
							<div class="flex flex-col gap-8">
								{block.paragraphs.map((paragraph) => (
									<div class="flex gap-3">
										<img
											src="/global/images/star-icon.webp"
											alt=""
											width="26"
											height="26"
											loading="lazy"
											class="size-[1.625rem] shrink-0"
										/>
										<p class="text-base leading-[1.625rem] font-light text-text">
											<strong class="font-medium">{paragraph.lead}</strong> {paragraph.text}
										</p>
									</div>
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-surface py-24 max-lg:py-16">
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			<h2 class="text-center font-medium text-text text-heading">{copy.meaningForUs.title}</h2>

			<ul class="mx-auto mt-16 grid max-w-[63.4375rem] grid-cols-3 gap-6 max-md:mt-10 max-md:grid-cols-1">
				{
					copy.meaningForUs.items.map((item) => (
						<li class="flex items-start gap-3">
							<img
								src="/global/images/star-icon.webp"
								alt=""
								width="26"
								height="26"
								loading="lazy"
								class="size-[1.625rem] shrink-0"
							/>
							<p class="text-xl leading-[1.625rem] font-medium text-text">{item}</p>
						</li>
					))
				}
			</ul>

			<CtaBox
				title={copy.workWithUs.title}
				text={copy.workWithUs.text}
				buttonLabel={copy.workWithUs.buttonLabel}
				buttonHref={contactHref}
				class="mt-20 max-md:mt-14"
			/>
		</div>
	</section>

	<section class="bg-surface-dark py-24 max-lg:py-16">
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			<h2 class="max-w-[48rem] font-medium text-text-inverse text-heading">{copy.process.title}</h2>
			<p class="mt-6 max-w-[40rem] text-base leading-[1.625rem] font-light text-text-inverse">{copy.process.text}</p>

			<div class="mt-14 grid grid-cols-3 gap-4 max-md:mt-10 max-md:grid-cols-1">
				{
					copy.process.steps.map(([title, text], index) => (
						<ProcessStepCard title={title} text={text} tone={stepTones[index]} />
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-background py-24 max-lg:py-16">
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			<h2 class="mx-auto max-w-[44rem] text-center font-medium text-text text-heading">
				{copy.pricing.title} <span class="text-primary">{copy.pricing.titleHighlight}</span>
			</h2>

			<ul class="mx-auto mt-16 grid max-w-[53rem] grid-cols-2 gap-x-16 gap-y-10 max-md:mt-10 max-md:grid-cols-1">
				{
					copy.pricing.items.map((item) => (
						<li class="flex gap-3">
							<img
								src="/global/images/star-icon.webp"
								alt=""
								width="26"
								height="26"
								loading="lazy"
								class="size-[1.625rem] shrink-0"
							/>
							<p class="text-xl leading-[1.625rem] font-medium text-text">{item}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="flow-root bg-surface pt-24 pb-24 max-lg:pt-16 max-lg:pb-16 [&_.clutch-widget]:overflow-hidden [&_.clutch-widget]:rounded-[20px]">
		<div class="mx-auto w-[92%]">
			<ClutchReviews />
		</div>
	</section>

	<section class="bg-surface pb-24 max-lg:pb-16">
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			<CtaBox
				title={copy.cta.title}
				text={copy.cta.text}
				buttonLabel={copy.cta.buttonLabel}
				buttonHref={contactHref}
			/>
		</div>
	</section>
</Base>
