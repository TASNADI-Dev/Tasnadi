const contactHref = getRelativeLocaleUrl(locale, "/contact").replace(/(.)\/$/, "$1");

const packages = copy.packages.cards.map((card, index) => ({
	...card,
	items: [...copy.packages.items, copy.packages[packageLastItem[index]]].map((item, itemIndex) => ({
		...item,
		included: packageIncluded[index][itemIndex],
	})),
}));
---

<Base title={copy.pageTitle}>
	<section class="bg-background pt-[8.75rem] max-lg:pt-32">
		<div
			class="mx-auto flex w-[92%] max-w-[76.875rem] items-start justify-between gap-x-12 gap-y-10 max-lg:flex-col"
		>
			<div class="max-w-[39rem]">
				<h1
					class="font-medium text-text text-display"
				>
					{copy.title}
				</h1>
				<p class="mt-4 text-2xl leading-9 font-normal text-text max-lg:text-xl max-lg:leading-8">
					{copy.text}
				</p>
			</div>

			<VideoCard
				src={copy.video.src}
				poster="/global/images/service-video-poster.webp"
				playLabel={copy.video.playLabel}
				class="shrink-0"
			/>
		</div>
	</section>

	<section class="bg-background pt-10 pb-[7.5rem] max-lg:pb-20">
		<div class="relative mx-auto w-[92%] max-w-[76.875rem]">
			<img
