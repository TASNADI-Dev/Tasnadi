const technologies = [
	{ name: "Webflow", src: "/global/technologies/webflow.webp" },
	{ name: "WordPress", src: "/global/technologies/wordpress.webp" },
	{ name: "HTML", src: "/global/technologies/html.webp" },
	{ name: "CSS", src: "/global/technologies/css.webp" },
	{ name: "JavaScript", src: "/global/technologies/javascript.webp" },
];

const packageIncluded = [
