---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import Badge from "../../components/Badge.astro";
import BlogCard from "../../components/BlogCard.astro";
import ClientsSection from "../../components/ClientsSection.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import Navigation from "../../components/Navigation.astro";
import NewsletterSection from "../../components/NewsletterSection.astro";
import PodcastCard from "../../components/PodcastCard.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import VideoCard from "../../components/VideoCard.astro";

const { entries: sampleCaseStudies } = await getEmDashCollection("case_studies", {
	locale: "hu",
	orderBy: { published_at: "desc" },
	limit: 1,
});
const sampleCaseStudy = sampleCaseStudies[0];

const { entries: samplePodcasts } = await getEmDashCollection("podcasts", {
	locale: "hu",
	orderBy: { published_at: "desc" },
	limit: 1,
});
const samplePodcast = samplePodcasts[0];

const { entries: samplePosts } = await getEmDashCollection("posts", {
	locale: "hu",
	orderBy: { published_at: "desc" },
	limit: 1,
});
const samplePost = samplePosts[0];

const serviceIconNames =["branding", "website", "webshop", "consulting", "strategy"] as const;

const serviceIconTones = ["primary", "accent"] as const;

const buttonVariants = ["primary", "secondary", "link-arrow", "link"] as const;

const navigationVariants = ["light", "dark"] as const;

const baseColors = [
	{ name: "black", value: "#000000", swatch: "bg-black" },
	{ name: "white", value: "#ffffff", swatch: "bg-white" },
	{ name: "gray-50", value: "#f8f8f8", swatch: "bg-gray-50" },
	{ name: "gray-200", value: "#e2e2e2", swatch: "bg-gray-200" },
	{ name: "gray-300", value: "#c4c4c4", swatch: "bg-gray-300" },
	{ name: "gray-400", value: "#afafaf", swatch: "bg-gray-400" },
	{ name: "gray-500", value: "#979797", swatch: "bg-gray-500" },
	{ name: "gray-600", value: "#656565", swatch: "bg-gray-600" },
	{ name: "gray-900", value: "#222222", swatch: "bg-gray-900" },
	{ name: "orange-300", value: "#ffb546", swatch: "bg-orange-300" },
	{ name: "orange-500", value: "#f39200", swatch: "bg-orange-500" },
	{ name: "orange-700", value: "#c97900", swatch: "bg-orange-700" },
	{ name: "blue-400", value: "#2cc0f6", swatch: "bg-blue-400" },
	{ name: "blue-500", value: "#05a3e0", swatch: "bg-blue-500" },
] as const;

const semanticColors = [
	{ name: "background", value: "white", swatch: "bg-background" },
	{ name: "background-dark", value: "black", swatch: "bg-background-dark" },
	{ name: "surface", value: "gray-50", swatch: "bg-surface" },
	{ name: "surface-dark", value: "gray-900", swatch: "bg-surface-dark" },
	{ name: "surface-dark-hover", value: "white at 10% opacity", swatch: "bg-surface-dark-hover" },
	{ name: "text", value: "gray-900", swatch: "bg-text" },
	{ name: "text-muted", value: "gray-600", swatch: "bg-text-muted" },
	{ name: "text-subtle", value: "gray-500", swatch: "bg-text-subtle" },
	{ name: "text-inverse", value: "white", swatch: "bg-text-inverse" },
	{ name: "text-inverse-muted", value: "gray-300", swatch: "bg-text-inverse-muted" },
	{ name: "text-inverse-subtle", value: "gray-400", swatch: "bg-text-inverse-subtle" },
	{ name: "border", value: "gray-200", swatch: "bg-border" },
	{ name: "border-strong", value: "gray-300", swatch: "bg-border-strong" },
	{ name: "border-inverse", value: "gray-600", swatch: "bg-border-inverse" },
	{ name: "primary", value: "orange-500", swatch: "bg-primary" },
	{ name: "primary-hover", value: "orange-300", swatch: "bg-primary-hover" },
	{ name: "primary-active", value: "orange-700", swatch: "bg-primary-active" },
	{ name: "accent", value: "blue-500", swatch: "bg-accent" },
	{ name: "shadow", value: "gray-900", swatch: "bg-shadow" },
] as const;

const colorGroups = [
	{ title: "Base colors", colors: baseColors },
	{ title: "Semantic colors", colors: semanticColors },
];
---

<Base title="Style guide">
	<div class="mx-auto max-w-[1230px] px-6 pt-32 pb-12">
		<h1 class="mb-12 text-4xl font-bold">Style guide</h1>

		<section class="mb-16">
			<h2 class="mb-8 text-2xl font-bold">Colors</h2>

			<div class="flex flex-col gap-10">
				{
					colorGroups.map(({ title, colors }) => (
						<div class="border-t border-border pt-6">
							<h3 class="mb-6 text-lg font-medium">{title}</h3>
							<ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6">
								{colors.map(({ name, value, swatch }) => (
									<li>
										<div class:list={["mb-3 h-20 rounded-[8px] border border-border", swatch]} />
										<code class="block text-base font-medium">{name}</code>
										<span class="text-sm text-text-muted">{value}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section>
			<h2 class="mb-8 text-2xl font-bold">Button</h2>

			<div class="flex flex-col gap-10">
				{
					buttonVariants.map((variant) => (
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium">
								<code>{variant}</code>
							</h3>
							<div class="flex flex-wrap items-center gap-8">
								<Button variant={variant} href="#">
									As a link
								</Button>
								<Button variant={variant}>As a button</Button>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Badge</h2>

			<div class="flex flex-col gap-10">
				<div class="border-t border-border pt-6">
					<h3 class="mb-4 text-lg font-medium"><code>variant="solid"</code></h3>
					<Badge>Our services</Badge>
				</div>
				<div class="border-t border-border pt-6">
					<h3 class="mb-4 text-lg font-medium"><code>variant="outline"</code></h3>
					<Badge variant="outline">Business</Badge>
				</div>
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Service icon</h2>

			<div class="flex flex-col gap-10">
				{
					serviceIconTones.map((tone) => (
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium">
								<code>tone="{tone}"</code>
							</h3>
							<ul class="flex flex-wrap items-center gap-6">
								{serviceIconNames.map((name) => (
									<li class="flex flex-col items-center gap-2">
										<ServiceIcon {name} {tone} />
										<code class="text-sm text-text-muted">{name}</code>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Navigation</h2>

			<div class="flex flex-col gap-10">
				{
					navigationVariants.map((variant) => (
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium">
								<code>variant="{variant}"</code>
							</h3>
							<div
								class:list={[
									"relative hidden h-[30rem] [contain:layout] rounded-[24px] xl:block",
									variant === "dark" ? "bg-surface" : "bg-surface-dark",
								]}
							>
								<Navigation {variant} />
							</div>
							<p class="text-text-muted xl:hidden">Preview is shown at desktop width only.</p>
						</div>
					))
				}
			</div>
		</section>

		{
			sampleCaseStudy && (
				<section class="mt-16">
					<h2 class="mb-8 text-2xl font-bold">Case study card</h2>

					<div class="border-t border-border pt-6">
						<div class="max-w-[24.5rem]">
							<CaseStudyCard
								href="#"
								title={sampleCaseStudy.data.hero_text}
								description={sampleCaseStudy.data.short_description}
								image={sampleCaseStudy.data.thumbnail}
								services={["Website", "Branding"]}
							/>
						</div>
					</div>
				</section>
			)
		}

		{
			samplePodcast && (
				<section class="mt-16">
					<h2 class="mb-8 text-2xl font-bold">Podcast card</h2>

					<div class="border-t border-border pt-6">
						<div class="inline-block max-w-full rounded-[24px] bg-surface-dark p-8">
							<div class="w-[36.9rem] max-w-full">
								<PodcastCard
									href="#"
									title={samplePodcast.data.title}
									image={samplePodcast.data.image}
									listenLabel="Listen on"
									links={[
										{ platform: "spotify", url: "#" },
										{ platform: "youtube", url: "#" },
										{ platform: "apple-podcasts", url: "#" },
										{ platform: "youtube-music", url: "#" },
									]}
								/>
							</div>
						</div>
					</div>
				</section>
			)
		}

		{
			samplePost && (
				<section class="mt-16">
					<h2 class="mb-8 text-2xl font-bold">Blog card</h2>

					<div class="flex flex-col gap-10">
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium"><code>variant="row"</code></h3>
							<div class="inline-block max-w-full rounded-[24px] bg-surface-dark p-8">
								<div class="w-[36.9rem] max-w-full">
									<BlogCard
										href="#"
										title={samplePost.data.title}
										image={samplePost.data.image}
										category="Business"
										date={samplePost.data.publishedAt}
										locale="hu"
									/>
								</div>
							</div>
						</div>
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium"><code>variant="stacked"</code></h3>
							<div class="w-[25rem] max-w-full">
								<BlogCard
									variant="stacked"
									href="#"
									title={samplePost.data.title}
									image={samplePost.data.image}
									category="Business"
									author="Tasnádi Olivér"
									date={samplePost.data.publishedAt}
									summary={samplePost.data.post_summary}
									locale="hu"
								/>
							</div>
						</div>
					</div>
				</section>
			)
		}

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Video card</h2>

			<div class="border-t border-border pt-6">
				<div class="inline-block rounded-[24px] bg-surface-dark p-8">
					<VideoCard
						src="/home/owner/video-hu.mp4"
						poster="/home/owner/video-poster.webp"
						playLabel="Play video"
						name="Name Surname"
						role="Role"
					/>
				</div>
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Newsletter section</h2>

			<div class="border-t border-border pt-6">
				<p class="mb-4 text-sm text-text-muted">
					Hungarian only (renders nothing on the English site). The form is live: it posts to Formspark.
				</p>
				<div class="overflow-hidden rounded-[24px] border border-border pb-10">
					<NewsletterSection />
				</div>
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Clients section</h2>

			<div class="border-t border-border pt-6">
				<div class="overflow-hidden rounded-[24px] border border-border">
					<ClientsSection
						title={[{ text: "Some of our" }, { text: "happy", tone: "primary" }, { text: "clients" }]}
						prevLabel="Previous video"
						nextLabel="Next video"
						items={[
							{ name: "Client one", src: "/home/testimonials/citi-kert.mp4" },
							{ name: "Client two", src: "/home/testimonials/ravenwood.mp4" },
							{ name: "Client three", src: "/home/testimonials/premiomed.mp4" },
							{ name: "Client four", src: "/home/testimonials/bookkeepie.mp4" },
						]}
					/>
				</div>
			</div>
		</section>
	</div>
</Base>
