---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import Badge from "../../components/Badge.astro";
import BlogCard from "../../components/BlogCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ClientsSection from "../../components/ClientsSection.astro";
import ClutchReviews from "../../components/ClutchReviews.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import CtaBox from "../../components/CtaBox.astro";
import HeroShapes from "../../components/HeroShapes.astro";
import PersonBioCard from "../../components/PersonBioCard.astro";
import ProcessStepCard from "../../components/ProcessStepCard.astro";
import Navigation from "../../components/Navigation.astro";
import NewsletterSection from "../../components/NewsletterSection.astro";
import type { ComponentProps } from "astro/types";
import PodcastCard from "../../components/PodcastCard.astro";
import InfoTooltip from "../../components/InfoTooltip.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import ServicePackage from "../../components/ServicePackage.astro";
import ProcessTimeline from "../../components/ProcessTimeline.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import TeamList from "../../components/TeamList.astro";
import VideoCard from "../../components/VideoCard.astro";

const locale = Astro.currentLocale === "en" ? "en" : "hu";

const copy = {
	hu: {
		services: ["Weboldalak", "Branding"],
		listenLabel: "Podcast meghallgatása:",
		category: "Üzlet",
		video: { playLabel: "Videó lejátszása", name: "Név Vezetéknév", role: "Beosztás" },
		cta: {
			title: "Érdekel a szolgáltatásunk?",
			text: "Jelentkezz egy ingyenes konzultációra, ahol felmérjük az elakadásaid, üzleti céljaid, és meghatározzuk a stratégiai lehetőségeket!",
			buttonLabel: "Ajánlatot kérek",
		},
		clients: {
			title: [{ text: "Néhány" }, { text: "elégedett", tone: "primary" as const }, { text: "ügyfelünk" }],
			prevLabel: "Előző videó",
			nextLabel: "Következő videó",
			names: ["Első ügyfél", "Második ügyfél", "Harmadik ügyfél", "Negyedik ügyfél"],
		},
		process: {
			label: "Folyamat idővonala",
			weeks: ["01. hét", "02. hét", "03. hét", "04. hét", "05. hét"],
			phases: ["Stratégia", "Tervezés", "Kivitelezés", "Hosting"],
			stepTitle: "Lépés neve",
			stepText: "A lépés rövid leírása, ami akár két sorba is tördelődhet.",
		},
	},
	en: {
		services: ["Websites", "Branding"],
		listenLabel: "Listen on",
		category: "Business",
		video: { playLabel: "Play video", name: "Name Surname", role: "Role" },
		cta: {
			title: "Interested?",
			text: "Let’s have a conversation and see how we can help boost your brand.",
			buttonLabel: "Sounds interesting; let’s chat!",
		},
		clients: {
			title: [{ text: "Some of our" }, { text: "happy", tone: "primary" as const }, { text: "clients" }],
			prevLabel: "Previous video",
			nextLabel: "Next video",
			names: ["Client one", "Client two", "Client three", "Client four"],
		},
		process: {
			label: "Process timeline",
			weeks: ["Week 01", "Week 02", "Week 03", "Week 04", "Week 05"],
			phases: ["Strategy", "Design", "Implementation", "Hosting"],
			stepTitle: "Step name",
			stepText: "A short description of the step that may wrap onto two lines.",
		},
	},
}[locale];

const { entries: sampleCaseStudies } = await getEmDashCollection("case_studies", {
	locale,
	orderBy: { published_at: "desc" },
	limit: 1,
});
const sampleCaseStudy = sampleCaseStudies[0];

const { entries: sampleTeam } = await getEmDashCollection("team_members", {
	locale,
	limit: 3,
});

const { entries: samplePodcasts } = await getEmDashCollection("podcasts", {
	locale,
	orderBy: { published_at: "desc" },
	limit: 1,
});
// There are no English podcast episodes or posts yet, so those samples fall back to the Hungarian entry
const samplePodcast =
	samplePodcasts[0] ??
	(await getEmDashCollection("podcasts", { locale: "hu", orderBy: { published_at: "desc" }, limit: 1 })).entries[0];
const podcastLinks: ComponentProps<typeof PodcastCard>["links"] = [
	{ platform: "spotify", url: "#" },
	{ platform: "youtube", url: "#" },
	{ platform: "apple-podcasts", url: "#" },
	{ platform: "youtube-music", url: "#" },
];

const { entries: samplePosts } = await getEmDashCollection("posts", {
	locale,
	orderBy: { published_at: "desc" },
	limit: 1,
});
const samplePost =
	samplePosts[0] ??
	(await getEmDashCollection("posts", { locale: "hu", orderBy: { published_at: "desc" }, limit: 1 })).entries[0];

const serviceIconNames =["branding", "website", "webshop", "consulting", "strategy"] as const;

const serviceIconTones = ["primary", "accent"] as const;

const buttonVariants = ["primary", "secondary", "light", "link-arrow", "link"] as const;

const navigationVariants = ["light", "dark"] as const;

const baseColors = [
	{ name: "black", value: "#000000", swatch: "bg-black" },
	{ name: "white", value: "#ffffff", swatch: "bg-white" },
	{ name: "gray-50", value: "#f8f8f8", swatch: "bg-gray-50" },
	{ name: "gray-200", value: "#e2e2e2", swatch: "bg-gray-200" },
	{ name: "gray-300", value: "#c4c4c4", swatch: "bg-gray-300" },
	{ name: "gray-400", value: "#afafaf", swatch: "bg-gray-400" },
	{ name: "gray-500", value: "#979797", swatch: "bg-gray-500" },
	{ name: "gray-600", value: "#656565", swatch: "bg-gray-600" },
	{ name: "gray-900", value: "#222222", swatch: "bg-gray-900" },
	{ name: "orange-300", value: "#ffb546", swatch: "bg-orange-300" },
	{ name: "orange-500", value: "#f39200", swatch: "bg-orange-500" },
	{ name: "orange-700", value: "#c97900", swatch: "bg-orange-700" },
	{ name: "blue-400", value: "#2cc0f6", swatch: "bg-blue-400" },
	{ name: "blue-500", value: "#05a3e0", swatch: "bg-blue-500" },
] as const;

const semanticColors = [
	{ name: "background", value: "white", swatch: "bg-background" },
	{ name: "background-dark", value: "black", swatch: "bg-background-dark" },
	{ name: "surface", value: "gray-50", swatch: "bg-surface" },
	{ name: "surface-dark", value: "gray-900", swatch: "bg-surface-dark" },
	{ name: "surface-dark-hover", value: "white at 10% opacity", swatch: "bg-surface-dark-hover" },
	{ name: "text", value: "gray-900", swatch: "bg-text" },
	{ name: "text-muted", value: "gray-600", swatch: "bg-text-muted" },
	{ name: "text-subtle", value: "gray-500", swatch: "bg-text-subtle" },
	{ name: "text-inverse", value: "white", swatch: "bg-text-inverse" },
	{ name: "text-inverse-muted", value: "gray-300", swatch: "bg-text-inverse-muted" },
	{ name: "text-inverse-subtle", value: "gray-400", swatch: "bg-text-inverse-subtle" },
	{ name: "text-disabled", value: "gray-300", swatch: "bg-text-disabled" },
	{ name: "border", value: "gray-200", swatch: "bg-border" },
	{ name: "border-strong", value: "gray-300", swatch: "bg-border-strong" },
	{ name: "border-inverse", value: "gray-600", swatch: "bg-border-inverse" },
	{ name: "primary", value: "orange-500", swatch: "bg-primary" },
	{ name: "primary-hover", value: "orange-300", swatch: "bg-primary-hover" },
	{ name: "primary-active", value: "orange-700", swatch: "bg-primary-active" },
	{ name: "accent", value: "blue-500", swatch: "bg-accent" },
	{ name: "shadow", value: "gray-900", swatch: "bg-shadow" },
	{ name: "process-phase-1", value: "blue-500", swatch: "bg-process-phase-1" },
	{ name: "process-phase-2", value: "orange-500", swatch: "bg-process-phase-2" },
	{ name: "process-phase-3", value: "gray-600", swatch: "bg-process-phase-3" },
	{ name: "process-phase-4", value: "gray-400", swatch: "bg-process-phase-4" },
	{ name: "process-grid-line", value: "gray-500", swatch: "bg-process-grid-line" },
] as const;

const colorGroups = [
	{ title: "Base colors", colors: baseColors },
	{ title: "Semantic colors", colors: semanticColors },
];
---

<Base title="Style guide">
	<div class="mx-auto max-w-[1230px] px-6 pt-32 pb-12">
		<h1 class="mb-12 text-4xl font-bold">Style guide</h1>

		<section class="mb-16">
			<h2 class="mb-8 text-2xl font-bold">Colors</h2>

			<div class="flex flex-col gap-10">
				{
					colorGroups.map(({ title, colors }) => (
						<div class="border-t border-border pt-6">
							<h3 class="mb-6 text-lg font-medium">{title}</h3>
							<ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6">
								{colors.map(({ name, value, swatch }) => (
									<li>
										<div class:list={["mb-3 h-20 rounded-[8px] border border-border", swatch]} />
										<code class="block text-base font-medium">{name}</code>
										<span class="text-sm text-text-muted">{value}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="mb-16">
			<h2 class="mb-8 text-2xl font-bold">Headings</h2>

			<div class="flex flex-col gap-10">
				{
					["text-display", "text-heading"].map((utility) => (
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium">
								<code>{utility}</code>
							</h3>
							<p class:list={[utility, "font-medium"]}>Egyszerűen jobb üzlet.</p>
						</div>
					))
				}
			</div>
		</section>

		<section>
			<h2 class="mb-8 text-2xl font-bold">Button</h2>

			<div class="flex flex-col gap-10">
				{
					buttonVariants.map((variant) => (
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium">
								<code>{variant}</code>
							</h3>
							<div
								class:list={[
									"flex flex-wrap items-center gap-8",
									variant === "light" && "rounded-[10px] bg-primary p-6",
								]}
							>
								<Button variant={variant} href="#">
									As a link
								</Button>
								<Button variant={variant}>As a button</Button>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Badge</h2>

			<div class="flex flex-col gap-10">
				<div class="border-t border-border pt-6">
					<h3 class="mb-4 text-lg font-medium"><code>variant="solid"</code></h3>
					<Badge>Our services</Badge>
				</div>
				<div class="border-t border-border pt-6">
					<h3 class="mb-4 text-lg font-medium"><code>variant="outline"</code></h3>
					<Badge variant="outline">Business</Badge>
				</div>
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Service icon</h2>

			<div class="flex flex-col gap-10">
				{
					serviceIconTones.map((tone) => (
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium">
								<code>tone="{tone}"</code>
							</h3>
							<ul class="flex flex-wrap items-center gap-6">
								{serviceIconNames.map((name) => (
									<li class="flex flex-col items-center gap-2">
										<ServiceIcon {name} {tone} />
										<code class="text-sm text-text-muted">{name}</code>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Service card</h2>

			<div class="flex flex-col gap-10">
				{
					(["stacked", "inline"] as const).map((layout) => (
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium">
								<code>layout="{layout}"</code>
							</h3>
							<ul class="max-w-[28rem]">
								<ServiceCard
									icon="website"
									title="Websites"
									text="We make sure your website generates leads and makes your company look trustworthy."
									moreLabel="Find out more"
									{layout}
								/>
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Info tooltip</h2>

			<div class="border-t border-border pt-6">
				<InfoTooltip text="A short explanation of the item." label="More info" />
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Service package</h2>

			<div class="grid grid-cols-3 gap-8 border-t border-border pt-6 max-lg:grid-cols-1">
				{
					[false, true].map((highlighted) => (
						<ServicePackage
							title={highlighted ? "Highlighted package" : "Package"}
							text="Short description of who the package is for."
							tooltipLabel="More info"
							{highlighted}
							items={[
								{ label: "Included item", included: true, tooltip: "What this item means." },
								{ label: "Not included item", included: false, tooltip: "What this item means." },
								{ label: "Included item", included: true, tooltip: "What this item means." },
							]}
						/>
					))
				}
				<ServicePackage
					title="Package without description"
					items={[
						{ label: "Included item", included: true },
						{ label: "Not included item", included: false },
						{ label: "Included item", included: true },
					]}
				/>
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Navigation</h2>

			<div class="flex flex-col gap-10">
				{
					navigationVariants.map((variant) => (
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium">
								<code>variant="{variant}"</code>
							</h3>
							<div
								class:list={[
									"relative hidden h-[30rem] [contain:layout] rounded-[24px] nav:block",
									variant === "dark" ? "bg-surface" : "bg-surface-dark",
								]}
							>
								<Navigation {variant} />
							</div>
							<p class="text-text-muted nav:hidden">Preview is shown at desktop width only.</p>
						</div>
					))
				}
			</div>
		</section>

		{
			sampleCaseStudy && (
				<section class="mt-16">
					<h2 class="mb-8 text-2xl font-bold">Case study card</h2>

					<div class="border-t border-border pt-6">
						<div class="max-w-[24.5rem]">
							<CaseStudyCard
								href="#"
								title={sampleCaseStudy.data.hero_text}
								description={sampleCaseStudy.data.short_description}
								image={sampleCaseStudy.data.thumbnail}
								services={copy.services}
							/>
						</div>
					</div>
				</section>
			)
		}

		{
			samplePodcast && (
				<section class="mt-16">
					<h2 class="mb-8 text-2xl font-bold">Podcast card</h2>

					<div class="flex flex-col gap-10">
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium"><code>variant="row"</code></h3>
							<div class="inline-block max-w-full rounded-[24px] bg-surface-dark p-8">
								<div class="w-[36.9rem] max-w-full">
									<PodcastCard
										href="#"
										title={samplePodcast.data.title}
										image={samplePodcast.data.image}
										listenLabel={copy.listenLabel}
										links={podcastLinks}
									/>
								</div>
							</div>
						</div>
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium"><code>variant="stacked"</code></h3>
							<div class="w-[25rem] max-w-full">
								<PodcastCard
									variant="stacked"
									href="#"
									title={samplePodcast.data.title}
									image={samplePodcast.data.image}
									listenLabel={copy.listenLabel}
									links={podcastLinks}
								/>
							</div>
						</div>
					</div>
				</section>
			)
		}

		{
			samplePost && (
				<section class="mt-16">
					<h2 class="mb-8 text-2xl font-bold">Blog card</h2>

					<div class="flex flex-col gap-10">
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium"><code>variant="row"</code></h3>
							<div class="inline-block max-w-full rounded-[24px] bg-surface-dark p-8">
								<div class="w-[36.9rem] max-w-full">
									<BlogCard
										href="#"
										title={samplePost.data.title}
										image={samplePost.data.image}
										category={copy.category}
										date={samplePost.data.publishedAt}
										locale={locale}
									/>
								</div>
							</div>
						</div>
						<div class="border-t border-border pt-6">
							<h3 class="mb-4 text-lg font-medium"><code>variant="stacked"</code></h3>
							<div class="w-[25rem] max-w-full">
								<BlogCard
									variant="stacked"
									href="#"
									title={samplePost.data.title}
									image={samplePost.data.image}
									category={copy.category}
									author="Tasnádi Olivér"
									date={samplePost.data.publishedAt}
									summary={samplePost.data.post_summary}
									locale={locale}
								/>
							</div>
						</div>
					</div>
				</section>
			)
		}

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Team list</h2>

			<div class="border-t border-border pt-6">
				<TeamList people={sampleTeam} />
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Video card</h2>

			<div class="border-t border-border pt-6">
				<div class="inline-block rounded-[24px] bg-surface-dark p-8">
					<VideoCard
						src={`/home/owner/video-${locale}.mp4`}
						poster="/home/owner/video-poster.webp"
						playLabel={copy.video.playLabel}
						name={copy.video.name}
						role={copy.video.role}
					/>
				</div>
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Process timeline</h2>

			<div class="border-t border-border pt-6">
				<div class="overflow-hidden rounded-[24px] bg-surface-dark py-8">
					<ProcessTimeline
						label={copy.process.label}
						weeks={copy.process.weeks}
						phases={[
							{ label: copy.process.phases[0], span: 1, tone: 1 },
							{ label: copy.process.phases[1], span: 2, tone: 2 },
							{ label: copy.process.phases[2], span: 1, tone: 3 },
							{ label: copy.process.phases[3], span: 1, tone: 4 },
						]}
						steps={[
							{ title: copy.process.stepTitle, text: copy.process.stepText, tone: 1, column: 1, span: 1, row: 1 },
							{ title: copy.process.stepTitle, text: copy.process.stepText, tone: 2, column: 2, span: 2, row: 2 },
							{ title: copy.process.stepTitle, text: copy.process.stepText, tone: 3, column: 4, span: 1, row: 3 },
							{ title: copy.process.stepTitle, text: copy.process.stepText, tone: 4, column: 5, span: 1, row: 4 },
						]}
					/>
				</div>
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Newsletter section</h2>

			<div class="border-t border-border pt-6">
				<p class="mb-4 text-sm text-text-muted">
					Hungarian only (renders nothing on the English site). The form is live: it posts to Formspark.
				</p>
				<div class="overflow-hidden rounded-[24px] border border-border">
					<NewsletterSection />
				</div>
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Clients section</h2>

			<div class="border-t border-border pt-6">
				<div class="overflow-hidden rounded-[24px] border border-border">
					<ClientsSection
						title={copy.clients.title}
						prevLabel={copy.clients.prevLabel}
						nextLabel={copy.clients.nextLabel}
						items={[
							{ name: copy.clients.names[0], src: "/global/testimonials/citi-kert.mp4" },
							{ name: copy.clients.names[1], src: "/global/testimonials/ravenwood.mp4" },
							{ name: copy.clients.names[2], src: "/global/testimonials/premiomed.mp4" },
							{ name: copy.clients.names[3], src: "/global/testimonials/bookkeepie.mp4" },
						]}
					/>
				</div>
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">CTA box</h2>

			<div class="border-t border-border pt-6">
				<CtaBox
					title={copy.cta.title}
					text={copy.cta.text}
					buttonLabel={copy.cta.buttonLabel}
					buttonHref="#"
				/>
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Breadcrumbs</h2>

			<div class="border-t border-border pt-6">
				<Breadcrumbs items={[{ label: "Services", href: "#" }, { label: "Websites", href: "#" }, { label: "Website design" }]} />
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Hero shapes</h2>

			<div class="border-t border-border pt-6">
				<div class="relative ml-48 h-[20rem] w-[19.5rem] rounded-[20px] border-2 border-dashed border-border">
					<HeroShapes class="max-lg:block" />
				</div>
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Person bio card</h2>

			<div class="border-t border-border pt-6">
				<PersonBioCard personSlug="peter-madacsi" class="max-w-[19.5rem]" />
			</div>
		</section>

		<section class="mt-16">
			<h2 class="mb-8 text-2xl font-bold">Process step card</h2>

			<div class="border-t border-border pt-6">
