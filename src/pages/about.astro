	titlePrefix?: string;
	titleWords: [string, string];
	paragraphs: string[];
	highlight: string;
	human: {
		title: string;
		intro: string;
		lead: string;
		body: [string, string];
		linkText: string;
		closing: string;
		teamAlt: string;
	};
	values: {
		tablistLabel: string;
		title: [string, string, string];
		intro: string;
		tabs: { label: string; items: { title: string; text: string }[] }[];
	};
	team: {
		title: string;
		intro: string;
	};
	story: {
		title: string;
		items: { year: string; text: string }[];
	};
	clients: {
		title: { text: string; tone?: "primary" | "accent" }[];
		prevLabel: string;
		nextLabel: string;
	};
	awards: {
		title: string;
		prevLabel: string;
		nextLabel: string;
		types: { award: string; qualification: string; publication: string };
		items: { title: string; alt: string }[];
	};
	cta: {
		title: string;
		text: string;
		buttonLabel: string;
		astronautAlt: string;
	};
};

// Language-independent data of the value tabs, in the same order as `copy.values.tabs`
const valueTabs = [
	{ id: "partnership", image: "partnership.webp" },
	{ id: "customer-centricity", image: "customer-centricity.webp" },
	{ id: "transparency", image: "transparency.webp" },
	{ id: "curiosity", image: "curiosity.webp" },
	{ id: "accountability", image: "accountability.png" },
	{ id: "independence", image: "independence.webp" },
];

// Language-independent data of the awards, in the same order as `copy.awards.items`
const awardItems = [
	{ type: "award", image: "clutch-logo-design-2023.webp", width: 500, height: 541 },
	{ type: "qualification", image: "bkik-trust-mark.webp", width: 500, height: 500 },
	{ type: "publication", image: "magyar-tervezografika-2023.webp", width: 292, height: 292 },
	{ type: "publication", image: "aranyrajzszog-2019.webp", width: 312, height: 226 },
	{ type: "award", image: "clutch-top-company-2022.webp", width: 500, height: 675 },
	{ type: "award", image: "clutch-most-reviewed.webp", width: 238, height: 328 },
	{ type: "award", image: "clutch-top-marketing-2021.webp", width: 306, height: 328 },
] as const;

// Team members flagged "Show on the About page" in the CMS, in the order of the original site; anyone not listed goes last
const teamOrder = [
	"oliver-tasnadi",
	"balazs-marton",
	"milan-somhegyi",
	"marci-fekete",
	"peter-madacsi",
	"attila-toth",
	"alexandra-gulyas",
];
const { entries: teamEntries, cacheHint: teamHint } = await getEmDashCollection("team_members", {
	where: { show_on_about: true },
	locale,
});
if (teamHint && Astro.cache?.enabled) Astro.cache.set(teamHint);
const rank = (slug: string) => {
	const index = teamOrder.indexOf(slug);
	return index === -1 ? teamOrder.length : index;
};
const team = [...teamEntries].sort((a, b) => rank(a.data.slug) - rank(b.data.slug));
