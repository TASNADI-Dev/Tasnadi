---
import Base from "../layouts/Base.astro";

const locale = Astro.currentLocale === "en" ? "en" : "hu";

const copy = {
	hu: {
		pageTitle: "Rólunk",
		description:
			"Ismerd meg a TASNADI csapatát, és hogy miért lehetünk éppen mi a tökéletes választás számodra.",
		titleWords: ["Rólad", "Rólunk"] as [string, string],
		paragraphs: [
			"Egy olyan kkv tulajdonosa vagy alkalmazottja vagy, amely nagyszerű termékkel vagy szolgáltatással rendelkezik, minőségi értékeket képvisel, és az ügyfelek elégedettségére összpontosít. Biztosan szeretnéd, ha mindezt az ügyfeleid egy pillantás alatt megértenék, amint megérkeznek a weboldaladra.",
			"Mi egy marketingoldalakra és webáruházakra szakosodott tervezőstúdió vagyunk, akiknek legfőbb célja, hogy online jelenléted olyan hatékony eszközzé alakítsuk, amely a látogatókat hűséges vásárlókká alakítja. Emellett nagy hangsúlyt fektetünk arra is, hogy a folyamatot ne csak egyszerűvé, hanem élvezetessé is tegyük a számodra.",
			"Kíváncsi vagy arra, hogy kik vagyunk, és miért lehetünk éppen mi a tökéletes választás számodra?",
		],
		highlight: "Hadd meséljünk többet!",
		human: {
			title: "Egyszerűen jó weboldalak, emberektől, embereknek.",
			intro:
				"Bármi is a szereped, mindenekelőtt ember vagy. Állandóan használsz weboldalakat, és valószínűleg frusztrál, ha nem felelnek meg az elvárásaidnak. Úgy érzed magad, mintha egy útvesztőben tévelyegnél – mintha az oldalt olyanok készítették volna, akik nem igazán értik, hogyan gondolkodnak és tájékozódnak az emberek.",
			lead: "Mi is átéltük ezt a frusztrációt. Ezért hisszük, hogy egy weboldal használatának könnyednek és intuitívnak kell lennie.",
			body: [
				"Nem kell azon gondolkodnod, hova kattints. Ha mégis, az az oldal hibája, nem a tiéd. Célunk, hogy olyan marketingeszközt hozzunk létre a vállalkozásodnak, amelyben a látogatók könnyebben megtalálják, amit keresnek, és ügyféllé vagy érdeklődővé válnak. Emellett azt szeretnénk, ha te is élvezned a ",
				" – hiszen ha az ügyfeleid kivételes felhasználói élményt érdemelnek, te is.",
			],
			linkText: "weboldalad elkészítésének folyamatát",
			closing:
				"Végső soron mi is csak emberek vagyunk, akik jobbá akarják tenni a dolgokat. Ez a mi módunk a világ jobbítására, egy weboldallal egyszerre: kiiktatjuk a bosszantó élményeket, és simábbá, élvezetesebbé tesszük az utadat.",
			teamAlt: "A TASNADI csapata együtt",
		},
		values: {
			tablistLabel: "Értékeink",
			title: ["A közös értékek ", "gyümölcsöző és élvezetes", " partnerséget ígérnek"],
			intro:
				"A TASNADI-nál az értékeink többek egyszerű elveknél – ezek az alapjai annak, hogyan érünk el kiemelkedő eredményeket, és hogyan építünk tartós partnerségeket.",
			tabs: [
				{
					label: "Partnerség",
					items: [
						{
							title: "Aktív együttműködés",
							text: "Hisszük, hogy az ügyfeleinket minden lépésbe bevonjuk, olyan együttműködő közeget teremtve, ahol a te véleményed alakítja az eredményt.",
						},
						{
							title: "Aktív részvétel",
							text: "Elvárjuk és ösztönözzük az ügyfeleink aktív részvételét, hogy a te elképzelésed a folyamatunk szerves része legyen.",
						},
						{
							title: "Felelősség és tulajdonosi szemlélet",
							text: "Teljes felelősséget vállalunk a munkánkért, és gondoskodunk róla, hogy a projekt minden részletét gondossággal és tisztességgel kezeljük.",
						},
						{
							title: "Az alapokon túl",
							text: "Nem csak megfelelünk az elvárásoknak, hanem igyekszünk túlszárnyalni őket, olyan megoldásokkal, amelyek többet nyújtanak.",
						},
					],
				},
				{
					label: "Ügyfélközpontúság",
					items: [
						{
							title: "Empátiára épülő hozzáállás",
							text: "A te helyedbe képzeljük magunkat, figyelembe vesszük a prioritásaidat, és az igényeidet állítjuk a munkánk középpontjába.",
						},
						{
							title: "A végfelhasználók megértése",
							text: "Mélyen beleássuk magunkat az ügyfeleid igényeibe, hogy a megoldásaink illeszkedjenek az elvárásaikhoz és tapasztalataikhoz.",
						},
						{
							title: "Testre szabott megoldások",
							text: "A stratégiánkat az egyedi helyzetedhez igazítjuk, hogy a megoldásaink a lehető legjobban illeszkedjenek hozzád és az ügyfeleidhez.",
						},
						{
							title: "Visszajelzések beépítése",
							text: "Határozottan keressük a visszajelzéseket és beépítjük őket, hogy a munkamódszerünk mind téged, mind az ügyfeleidet jobban szolgálja.",
						},
					],
				},
				{
					label: "Átláthatóság",
					items: [
						{
							title: "Pénzügyi átláthatóság",
							text: "A pénzügyi ügyeinkben teljes átláthatóságot tartunk, így nincsenek rejtett költségek vagy kellemetlen meglepetések.",
						},
						{
							title: "A korlátaink ismerete",
							text: "Őszinték vagyunk a képességeinkkel és a korlátainkkal kapcsolatban, így sosem marad kérdés, mit tudunk vállalni.",
						},
						{
							title: "Gyors és világos kommunikáció",
							text: "A kommunikációnk gyors és átlátható, így a folyamat minden lépésénél képben vagy.",
						},
						{
							title: "Egyértelmű keretek",
							text: "Egyértelműen kijelöljük a kommunikáció kereteit – az elérhetőségünket –, és garantáljuk a hatékony, tiszteletteljes együttműködést.",
						},
					],
				},
				{
					label: "Kíváncsiság",
					items: [
						{
							title: "Megállás nélküli tanulás",
							text: "A kíváncsiságunk hajt minket, hogy folyamatosan új tudást és meglátásokat keressünk, és ezeket a munkánk javítására használjuk.",
						},
						{
							title: "Innovatív problémamegoldás",
							text: "A kíváncsiságunkkal kreatív megoldásokat találunk összetett problémákra, és feszegetjük a hagyományos gondolkodás határait.",
						},
						{
							title: "Tudásmegosztás",
							text: "Hisszük, hogy a felfedezéseink és meglátásaink megosztása gazdagítja a projektjeinket és a te élményedet is.",
						},
						{
							title: "Alkalmazkodás és fejlődés",
							text: "A tanulási vágyunk rugalmassá és alkalmazkodóképessé tesz minket, így mindig a szakma trendjei és kihívásai előtt járunk.",
						},
					],
				},
				{
					label: "Felelősségvállalás",
					items: [
						{
							title: "Felelősség az eredményekért",
							text: "Teljes felelősséget vállalunk a munkánkért, garantálva a minőséget és a megbízhatóságot.",
						},
						{
							title: "Határidők betartása",
							text: "Az időzítés kulcsfontosságú. Betartjuk a határidőket, hogy a projektek a megfelelő ütemben haladjanak.",
						},
						{
							title: "Proaktív megoldások",
							text: "Ha kihívások merülnek fel, azonnal szembenézünk velük, és proaktívan keressük a megoldást, hogy minden zökkenőmentesen haladjon.",
						},
						{
							title: "Folyamatos fejlődés",
							text: "Folyamatosan értékeljük és finomítjuk a folyamatainkat, hogy javítsuk a teljesítményünket, és kiemelkedő eredményeket érjünk el.",
						},
					],
				},
				{
					label: "Függetlenség",
					items: [
						{
							title: "Technológiafüggetlenség",
							text: "Minden projekthez a legjobb eszközöket és technológiákat választjuk, előítéletektől és megkötésektől mentesen.",
						},
						{
							title: "Ideológiai szabadság",
							text: "A megközelítésünket azon alapozzuk, ami a projektednek a legjobb, nem merev ideológiákon vagy előre meghatározott módszereken.",
						},
						{
							title: "Személyre szabott megközelítés",
							text: "Függetlenül dolgozunk, hogy úgy alakítsuk a módszereinket és stratégiáinkat, hogy a megoldásaink egyedileg illeszkedjenek az igényeidhez.",
						},
						{
							title: "Alkotói szabadság",
							text: "A függetlenségünk rugalmasságot ad, hogy innovatív megoldásokat fedezzünk fel, és a stratégiákat kifejezetten az igényeidhez alakítsuk, hagyományos megkötések és korlátok nélkül.",
						},
					],
				},
			],
		},
	},
	en: {
		pageTitle: "About",
		description:
			"Get to know the TASNADI team and why we might just be the perfect fit for your needs.",
		titlePrefix: "About",
		titleWords: ["You", "Us"] as [string, string],
		paragraphs: [
			"You own or work for an SME with a great product or service, good values, focused on customer satisfaction. You’d like your customers to understand all that at a glance, as soon as they arrive on your website.",
			"We’re a design studio focused on marketing sites and webshops, and our goal is to transform your online presence into a powerful tool that converts visitors into loyal customers. We’re also highly committed to making the process not only streamlined, but enjoyable for you, our future client.",
			"Are you curious about who we are and why we might just be the perfect fit for your needs?",
		],
		highlight: "Let us tell you more.",
		human: {
			title: "Simply good websites, by humans, for humans.",
			intro:
				"No matter your role, you’re always a human first. You use websites constantly, and it’s likely to cause frustration when they don’t meet your expectations. They make you feel like you’re navigating a maze. It’s as if the website is a creation of people who don’t quite get how real humans think and navigate.",
			lead: "We’ve experienced that frustration too. That’s why we believe that using a website should be effortless and intuitive.",
			body: [
				"You shouldn’t have to think about where to click. If you do, that’s on the website, not you. Our goal is to help your business create a marketing tool that makes it easier for visitors to find what they’re looking for and become customers or leads. Plus, we want you to enjoy ",
				" – after all, if your customers deserve an exceptional user experience, you do too.",
			],
			linkText: "the process of building your site",
			closing:
				"At the end of the day, we’re just people trying to make things better. This is our way of improving the world, one website at a time, by eliminating those annoying experiences and making your journey smoother and more enjoyable.",
			teamAlt: "The whole TASNADI team",
		},
		values: {
			tablistLabel: "Our values",
			title: ["Shared values mean a ", "rewarding and enjoyable", " partnership awaits"],
			intro:
				"At TASNADI, our values are more than just principles – they are the foundation of how we deliver exceptional results and build lasting partnerships.",
			tabs: [
				{
					label: "Partnership",
					items: [
						{
							title: "Engaged collaboration",
							text: "We believe in involving our clients at every step, fostering a collaborative environment where your input shapes the outcome.",
						},
						{
							title: "Active participation",
							text: "We expect and encourage active involvement from our clients, ensuring that your vision is integral to our process.",
						},
						{
							title: "Responsibility & ownership",
							text: "We take full responsibility for our work, ensuring that every aspect of the project is handled with care and integrity.",
						},
						{
							title: "Beyond the basics",
							text: "We don’t just meet expectations; we strive to exceed them, offering solutions that go above and beyond.",
						},
					],
				},
				{
					label: "Customer centricity",
					items: [
						{
							title: "Empathy-driven approach",
							text: "We put ourselves in your shoes, accommodating your priorities and ensuring your needs are at the forefront of our efforts.",
						},
						{
							title: "Understanding end-users",
							text: "We delve deep into understanding the needs of your customers, aligning our solutions with their expectations and experiences.",
						},
						{
							title: "Tailored solutions",
							text: "We customize our strategies to fit your unique situation, ensuring that the solutions we provide are the best fit for you and your customers.",
						},
						{
							title: "Feedback integration",
							text: "We firmly seek and integrate feedback, honing our approach to better serve both you and your clients.",
						},
					],
				},
				{
					label: "Transparency",
					items: [
						{
							title: "Financial clarity",
							text: "We maintain complete transparency in our financial dealings, ensuring that there are no hidden costs or surprises.",
						},
						{
							title: "Understanding limits",
							text: "We are upfront about our capabilities and constraints, so there’s never any ambiguity about what we can deliver.",
						},
						{
							title: "Swift & clear communication",
							text: "Our communication is prompt and transparent, keeping you informed every step of the way.",
						},
						{
							title: "Clear-cut boundaries",
							text: "We set clear boundaries for communication – our availability – and guarantee efficient and respectful interactions.",
						},
					],
				},
				{
					label: "Curiosity",
					items: [
						{
							title: "Relentless learning",
							text: "Our curiosity drives us to continually seek out new knowledge and insights, applying them to enhance our work.",
						},
						{
							title: "Innovative problem-solving",
							text: "We leverage our curiosity to find creative solutions to complex problems, pushing the boundaries of conventional thinking.",
						},
						{
							title: "Knowledge sharing",
							text: "We believe in sharing our discoveries and insights, enriching our projects and your experience.",
						},
						{
							title: "Adapting and evolving",
							text: "Our eagerness to learn keeps us agile and adaptable, ensuring that we stay ahead of industry trends and challenges.",
						},
					],
				},
				{
					label: "Accountability",
					items: [
						{
							title: "Ownership over results",
							text: "We take full responsibility for our work, guaranteeing quality and reliability.",
						},
						{
							title: "Commitment to deadlines",
							text: "Timeliness is key. We adhere to deadlines to keep projects on track and on schedule.",
						},
						{
							title: "Proactive solutions",
							text: "When challenges arise, we address them head-on and proactively seek solutions to keep things moving smoothly.",
						},
						{
							title: "Continuous improvement",
							text: "We continually assess and refine our processes to enhance our performance and deliver exceptional results.",
						},
					],
				},
				{
					label: "Independence",
					items: [
						{
							title: "Technology-agnostic",
							text: "We choose the best tools and technologies for each project, free from biases or constraints.",
						},
						{
							title: "Ideological freedom",
							text: "We manage our approach based on what’s best for your project, not rigid ideologies or predefined methods.",
						},
						{
							title: "Customized approach",
							text: "We work independently to tailor our methods and strategies, ensuring that our solutions are uniquely suited to your needs.",
						},
						{
							title: "Creative freedom",
							text: "Our independence grants us the flexibility to explore innovative solutions and tailor strategies specifically to your needs, unbounded by conventional constraints or limitations.",
						},
					],
				},
			],
		},
	},
}[locale] as {
	pageTitle: string;
	description: string;
	titlePrefix?: string;
	titleWords: [string, string];
	paragraphs: string[];
	highlight: string;
	human: {
		title: string;
		intro: string;
		lead: string;
		body: [string, string];
		linkText: string;
		closing: string;
		teamAlt: string;
	};
	values: {
		tablistLabel: string;
		title: [string, string, string];
		intro: string;
		tabs: { label: string; items: { title: string; text: string }[] }[];
	};
};

// Language-independent data of the value tabs, in the same order as `copy.values.tabs`
const valueTabs = [
	{ id: "partnership", image: "partnership.webp" },
	{ id: "customer-centricity", image: "customer-centricity.webp" },
	{ id: "transparency", image: "transparency.webp" },
	{ id: "curiosity", image: "curiosity.webp" },
	{ id: "accountability", image: "accountability.png" },
	{ id: "independence", image: "independence.webp" },
];
---

<Base title={copy.pageTitle} description={copy.description}>
	<section
		data-about-hero
		data-title="main"
		class="group/hero relative h-[200vh] overflow-clip bg-background-dark pt-[11.25rem] text-center motion-reduce:h-auto motion-reduce:pb-48"
	>
		<div
			data-title-bar
			class="sticky top-0 z-20 flex flex-col items-center bg-linear-to-b from-background-dark from-40% to-transparent py-40 motion-reduce:static"
		>
			<h1
				class="inline-flex items-start justify-center text-[4.375rem] leading-[5.25rem] font-medium tracking-[-0.02em] text-text-inverse max-lg:text-[2.1875rem] max-lg:leading-[2.75rem]"
			>
				{copy.titlePrefix && <span class="mr-5 max-lg:mr-4">{copy.titlePrefix}</span>}
				<span
					class:list={[
						"inline-grid overflow-hidden",
						copy.titlePrefix ? "justify-items-start" : "justify-items-center",
					]}
				>
					<span
						data-title-word="main"
						class="col-start-1 row-start-1 group-data-[title=alt]/hero:-translate-y-full"
					>
						{copy.titleWords[0]}
					</span>
					<span
						data-title-word="alt"
						aria-hidden="true"
						class="col-start-1 row-start-1 -translate-y-full text-primary group-data-[title=alt]/hero:translate-y-0 motion-reduce:hidden"
					>
						{copy.titleWords[1]}
					</span>
				</span>
			</h1>
		</div>

		<div
			class="sticky top-0 z-10 mx-auto max-w-[19.375rem] perspective-[50rem] max-md:max-w-[15.625rem] max-md:perspective-[62.5rem] motion-reduce:static motion-reduce:perspective-none"
		>
			<div
				data-about-crawl
				class="flex origin-center transform-3d flex-col gap-[1.625rem] text-base leading-[1.625rem] font-light text-text-inverse [transform:rotateX(45deg)_translateY(var(--crawl-y,100vh))] motion-reduce:[transform:none]"
			>
				{
					copy.paragraphs.map((paragraph, index) => (
						<p>
							{paragraph}
							{index === copy.paragraphs.length - 1 && (
								<>
									<br />
									<span class="text-primary">{copy.highlight}</span>
								</>
							)}
						</p>
					))
				}
			</div>
		</div>

		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-x-0 top-[90svh] z-30 flex h-5 justify-center text-text-inverse transition-opacity duration-300 group-data-[scrolled=true]/hero:opacity-0 motion-reduce:hidden"
		>
			<svg
				width="12"
				height="24"
				viewBox="0 1 12 18"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
				class="animate-nudge-down"
			>
				<path
					d="M6.75 1.5a.75.75 0 0 0-1.5 0h1.5ZM5.47 16.03a.75.75 0 0 0 1.06 0l4.773-4.773a.75.75 0 1 0-1.06-1.06L6 14.44 1.757 10.197a.75.75 0 0 0-1.06 1.06l4.773 4.773ZM5.25 1.5v14h1.5v-14h-1.5Z"
					fill="currentColor"></path>
			</svg>
		</div>

		<img
			src="/about/curved-shape.svg"
			alt=""
			width="1512"
			height="161"
			loading="eager"
			class="absolute inset-x-0 bottom-0 z-0 -mb-px h-auto w-full max-sm:-bottom-1.5"
		/>
	</section>

	<section class="relative bg-background pt-12 pb-24 lg:pt-20 lg:pb-[12.5rem]">
		<img
			src="/about/values/black-bottom-shape.svg"
			alt=""
			width="1512"
			height="127"
			loading="lazy"
			class="absolute inset-x-0 bottom-0 z-0 -mb-px h-auto w-full"
		/>
		<img
			src="/about/astronaut.webp"
			srcset="/about/astronaut-500.webp 500w, /about/astronaut-800.webp 800w, /about/astronaut.webp 1635w"
			sizes="(min-width: 64rem) min(35vw, 31.25rem), 12rem"
			alt=""
			width="1635"
			height="1116"
			loading="lazy"
			class="absolute top-0 right-0 w-48 lg:w-[35vw] lg:max-w-[31.25rem]"
		/>

		<div class="relative mx-auto w-[92%] max-w-[76.875rem]">
			<div class="max-w-[39.125rem] pt-32 lg:pt-0">
				<h2
					class="text-[2rem] leading-[2.75rem] font-medium tracking-[-0.02em] text-text lg:text-[3rem] lg:leading-[4.5rem]"
				>
					{copy.human.title}
				</h2>
				<p class="mt-2 text-base leading-[1.625rem] font-medium text-text-muted">
					{copy.human.intro}
				</p>
			</div>

			<div
				class="mt-10 flex items-center justify-between gap-8 max-lg:flex-col lg:mt-10"
			>
				<img
					src="/about/team.webp"
					srcset="/about/team-500.webp 500w, /about/team-800.webp 800w, /about/team.webp 1024w"
					sizes="(min-width: 64rem) 30rem, 92vw"
					alt={copy.human.teamAlt}
					width="1024"
					height="683"
					loading="lazy"
					class="aspect-[3/2] w-full max-w-[30rem] rounded-[300px] object-cover max-lg:max-w-none max-lg:rounded-[7.5rem]"
				/>

				<div
					class="flex max-w-[30.875rem] flex-col gap-5 text-base leading-[1.625rem] text-text-muted"
				>
					<p class="font-medium">{copy.human.lead}</p>
					<p>
						{copy.human.body[0]}<a
							href="#"
							class="text-accent transition-colors hover:text-primary-hover">{copy.human.linkText}</a
						>{copy.human.body[1]}
					</p>
					<p>{copy.human.closing}</p>
				</div>
			</div>
		</div>
	</section>
	<section
		data-about-values
		class="relative overflow-x-clip bg-background-dark pt-32 pb-16 text-text-inverse lg:pt-[11.25rem] lg:pb-[6.25rem]"
	>
		<img
			data-about-astronaut
			src="/about/values/astronaut-white.webp"
			alt=""
			width="360"
			height="270"
			loading="lazy"
			class="pointer-events-none absolute top-0 right-4 z-10 w-28 will-change-transform sm:w-36 lg:right-[4.5rem] lg:w-[11.25rem]"
		/>

		<div class="relative mx-auto w-[92%] max-w-[76.875rem]">
			<div class="mx-auto max-w-[56.5625rem] text-center">
				<h2
					class="text-[2rem] leading-[2.75rem] font-medium tracking-[-0.02em] lg:text-[3rem] lg:leading-[4.5rem]"
				>
					{copy.values.title[0]}<span class="text-primary">{copy.values.title[1]}</span
					>{copy.values.title[2]}
				</h2>
				<p class="mx-auto mt-6 max-w-[31.25rem] text-base leading-[1.625rem] font-light lg:mt-10">
					{copy.values.intro}
				</p>
			</div>

			<div data-tabs class="mt-12 grid gap-6 lg:mt-20 lg:grid-cols-2 lg:gap-4">
				<div
					role="tablist"
					aria-label={copy.values.tablistLabel}
					aria-orientation="vertical"
					class="relative flex snap-x gap-2 overflow-x-auto pb-2 [scrollbar-width:none] lg:snap-none lg:flex-col lg:self-start lg:overflow-visible lg:pb-0 [&::-webkit-scrollbar]:hidden"
				>
					{
						copy.values.tabs.map((tab, index) => (
							<button
								type="button"
								role="tab"
								id={`values-tab-${valueTabs[index].id}`}
								aria-controls={`values-panel-${valueTabs[index].id}`}
								aria-selected={index === 0 ? "true" : "false"}
								tabindex={index === 0 ? 0 : -1}
								class="group flex shrink-0 cursor-pointer snap-start items-center justify-between gap-4 rounded-[20px] border border-border-inverse px-4 py-3.5 text-left text-lg leading-6 font-medium whitespace-nowrap text-text-inverse transition-colors duration-200 hover:bg-surface-dark-hover focus-visible:-outline-offset-2 focus-visible:outline-2 focus-visible:outline-primary aria-selected:border-surface aria-selected:bg-surface aria-selected:text-primary aria-selected:hover:bg-surface motion-reduce:transition-none lg:text-xl lg:whitespace-normal"
							>
								{tab.label}
								<svg
									aria-hidden="true"
									width="20"
									height="16"
									viewBox="0 0 20 16"
									fill="none"
									xmlns="http://www.w3.org/2000/svg"
									class="hidden shrink-0 opacity-0 transition-opacity duration-200 group-aria-selected:opacity-100 lg:block"
								>
									<path
										d="M1 8h17m0 0-6.5-6.5M18 8l-6.5 6.5"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</button>
						))
					}
				</div>

				<div>
					{
						copy.values.tabs.map((tab, index) => (
							<div
								role="tabpanel"
								id={`values-panel-${valueTabs[index].id}`}
								aria-labelledby={`values-tab-${valueTabs[index].id}`}
								tabindex="0"
								hidden={index !== 0}
								class="rounded-[20px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-safe:animate-tab-in"
							>
								<div class="relative flex aspect-[55/26] items-end overflow-hidden rounded-[20px] border border-border-strong">
									<img
										src={`/about/values/${valueTabs[index].image}`}
										alt=""
										width="550"
										height="260"
										loading="lazy"
										class="absolute inset-0 size-full object-cover"
									/>
									<div
										aria-hidden="true"
										class="absolute inset-0 bg-linear-to-t from-background-dark/70 to-transparent"
									/>
									<h3 class="relative p-5 text-[1.75rem] leading-9 font-medium sm:p-6 lg:text-[2.125rem] lg:leading-[2.625rem]">
										{tab.label}
									</h3>
								</div>

								<ol role="list" class="mt-6 flex flex-col gap-6">
									{tab.items.map((item, itemIndex) => (
										<li class="grid grid-cols-[1.75rem_1fr] gap-x-3">
											<span
												aria-hidden="true"
												class="flex size-7 items-center justify-center rounded-full border-[1.5px] border-primary text-xs font-medium text-primary"
											>
												{itemIndex + 1}
											</span>
											<div>
												<h4 class="text-base leading-7 font-medium">{item.title}</h4>
												<p class="mt-2 text-sm leading-[1.375rem] text-text-inverse-muted">{item.text}</p>
											</div>
										</li>
									))}
								</ol>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	// Starts the About page scripts: hero scroll effects, the sliding astronaut and the value tabs.
	import { initAboutAstronaut } from "../scripts/about-astronaut";
	import { initAboutHero } from "../scripts/about-hero";
	import { initTabs } from "../scripts/tabs";

	initAboutHero();
	initAboutAstronaut();
	document.querySelectorAll<HTMLElement>("[data-tabs]").forEach(initTabs);
</script>
