---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Badge from "../../components/Badge.astro";
import Button from "../../components/Button.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import CtaBox from "../../components/CtaBox.astro";
import PageHero from "../../components/PageHero.astro";
import { loadCaseStudies, parseProjectFilters } from "../../utils/case-studies";
import { hasLocaleContent } from "../../utils/locale-content";

const locale = Astro.currentLocale === "en" ? "en" : "hu";

// There is no projects page in a language without case studies, so /en/projects is a 404 until the first English one is published
if (!(await hasLocaleContent("case_studies", locale))) {
	return Astro.rewrite("/404");
}

const copy = {
	hu: {
		pageTitle: "Munkáink",
		description:
			"Az esettanulmányaink segítségével jobban megértheted, hogyan tudunk segíteni az eladások növelésében.",
		title: "Projektjeink",
		text: "Az alábbi esettanulmányok segítségével jobban megértheted, hogyan tudunk segíteni az eladások növelésében.",
		servicesLabel: "Szolgáltatásaink",
		industriesLabel: "Iparág",
		filter: "Szűrés",
		reset: "Alaphelyzet",
		noResults: "Egyetlen projekt sem felel meg a szűrési feltételeknek.",
		cta: {
			title: "Érdekel a szolgáltatásunk?",
			text: "Jelentkezz egy ingyenes konzultációra, ahol felmérjük az elakadásaid, üzleti céljaid, és meghatározzuk a stratégiai lehetőségeket!",
			buttonLabel: "Ajánlatot kérek",
		},
	},
	en: {
		pageTitle: "Work",
		description:
			"Our case studies show how we help our clients grow their sales.",
		title: "Our projects",
		text: "The case studies below show you how we can help you increase your sales.",
		servicesLabel: "Our services",
		industriesLabel: "Industry",
		filter: "Filter",
		reset: "Reset",
		noResults: "No projects match your filters.",
		cta: {
			title: "Interested?",
			text: "Let’s have a conversation and see how we can help boost your brand.",
			buttonLabel: "Sounds interesting; let’s chat!",
		},
	},
}[locale];

const filters = parseProjectFilters(Astro.url.searchParams);
const { caseStudies, services, industries, activeServices, activeIndustries, hints } = await loadCaseStudies(
	locale,
	filters,
);
if (Astro.cache?.enabled) hints.forEach((hint) => Astro.cache.set(hint));

const projectsPath = getRelativeLocaleUrl(locale, "/projects").replace(/(.)\/$/, "$1");

const groups = [
	{ name: "service", label: copy.servicesLabel, options: services, active: activeServices },
	{ name: "industry", label: copy.industriesLabel, options: industries, active: activeIndustries },
];
---

<Base title={copy.pageTitle} description={copy.description} navVariant="dark">
	<PageHero titleHighlight={copy.title} text={copy.text} />

	<section id="filters" class="scroll-mt-28 bg-background pt-4 pb-8">
		<form
			data-list-filters
			action={`${projectsPath}#filters`}
			method="get"
			class="mx-auto flex w-[92%] max-w-[32.5rem] flex-col items-center gap-6 rounded-[8px] bg-background p-6 shadow-[0_4px_30px_color-mix(in_srgb,var(--color-shadow)_15%,transparent)]"
		>
			{
				groups.map((group) => (
					<fieldset class="m-0 min-w-0 border-0 p-0">
						<legend class="mx-auto mb-3 text-center text-base leading-6 font-medium text-text">{group.label}</legend>
						<ul class="flex flex-wrap justify-center gap-2">
							{group.options.map((option) => (
								<li>
									<label class="cursor-pointer">
										<input
											type="checkbox"
											name={group.name}
											value={option.slug}
											checked={group.active.includes(option.slug)}
											class="peer sr-only"
										/>
										<Badge
											variant="outline"
											class="transition-colors duration-200 hover:bg-[color-mix(in_srgb,var(--color-accent)_12%,var(--color-background))] peer-checked:bg-accent peer-checked:text-text-inverse peer-checked:hover:bg-accent peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent motion-reduce:transition-none"
										>
											{option.label}
										</Badge>
									</label>
								</li>
							))}
						</ul>
					</fieldset>
				))
			}

			<button type="submit" class="sr-only">{copy.filter}</button>
			<Button variant="link" href={`${projectsPath}#filters`} data-list-reset>{copy.reset}</Button>
		</form>
	</section>

	<section
		data-list-results
		class="bg-background pt-4 pb-24 transition-opacity duration-200 data-[loading=true]:opacity-50 max-lg:pb-16 motion-reduce:transition-none"
	>
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			{
				caseStudies.length === 0 ? (
					<p class="text-center text-xl leading-8 font-medium text-text-muted">{copy.noResults}</p>
				) : (
					<ul class="grid grid-cols-3 gap-8 max-lg:grid-cols-2 max-md:grid-cols-1">
						{caseStudies.map((entry) => (
							<li>
								<CaseStudyCard
									href={getRelativeLocaleUrl(locale, `/case-studies/${entry.data.slug}`)}
									title={entry.data.hero_text}
									description={entry.data.short_description}
									image={entry.data.thumbnail}
									services={entry.references?.services.entries.map((service) => service.data.title)}
								/>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>

	<section class="bg-background pb-24 max-lg:pb-16">
		<div class="mx-auto w-[92%] max-w-[76.875rem]">
			<CtaBox
				title={copy.cta.title}
				text={copy.cta.text}
				buttonLabel={copy.cta.buttonLabel}
				buttonHref={getRelativeLocaleUrl(locale, "/contact").replace(/(.)\/$/, "$1")}
			/>
		</div>
	</section>
</Base>

<script>
	// Loads the in-place list filtering (no page reload when toggling services or industries).
	import "../../scripts/list-filters";
</script>
