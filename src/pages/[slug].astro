---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import { getContentSeo } from "emdash/seo";
import Base from "../layouts/Base.astro";
import { resolveSiteIdentity } from "../utils/site-identity";
import { localizePath } from "../i18n/routes";
import { getEntryAlternates } from "../utils/entry-alternates";
import { rewriteToNotFound } from "../utils/not-found";

const locale = Astro.currentLocale === "en" ? "en" : "hu";
const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return rewriteToNotFound(Astro);
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return rewriteToNotFound(Astro);
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: localizePath(`/${slug}`, locale),
});
const alternates = await getEntryAlternates("pages", String(page.data.id), (s) => `/${s}`);
---

<Base
	title={seo.title}
	titleOverride={getContentSeo(page)?.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	{alternates}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article>
		<h1 {...page.edit.title}>{page.data.title}</h1>

		<PortableText value={page.data.content} />
	</article>
</Base>
