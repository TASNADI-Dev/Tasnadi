---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import type { CacheHint } from "emdash";
import { Image, PortableText } from "emdash/ui";
import { getContentSeo } from "emdash/seo";
import Base from "../../layouts/Base.astro";
import Badge from "../../components/Badge.astro";
import CtaBox from "../../components/CtaBox.astro";
import TeamList from "../../components/TeamList.astro";
import { mediaFileUrl } from "../../utils/media-url";
import { resolveSiteIdentity } from "../../utils/site-identity";
import { localizePath } from "../../i18n/routes";
import { getEntryAlternates } from "../../utils/entry-alternates";
import { rewriteToNotFound } from "../../utils/not-found";

const locale = Astro.currentLocale === "en" ? "en" : "hu";
const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return rewriteToNotFound(Astro);
}

// A case study is never shown in another language, so a missing English translation is a 404 instead of a Hungarian fallback
const { entry: caseStudy, cacheHint } = await getEmDashEntry("case_studies", slug, {
	locale,
	references: { services: true, industry: true, our_team: true },
});

// EmDash falls back to the Hungarian entry when there is no translation, so the entry's own locale is checked too
if (!caseStudy || (caseStudy.data as { locale?: string }).locale !== locale) {
	return rewriteToNotFound(Astro);
}

const hints: CacheHint[] = [cacheHint];
if (Astro.cache?.enabled) hints.forEach((hint) => Astro.cache.set(hint));

const tags = [
	...(caseStudy.references?.services.entries ?? []),
	...(caseStudy.references?.industry.entries ?? []),
].map((entry) => entry.data.title);

// The three step names are the same on every case study
const copy = {
	hu: {
		strategy: "Stratégia",
		design: "Tervezés",
		implementation: "Kivitelezés",
		startedTitle: "Honnan indultunk – hová jutottunk",
		compareLabel: "Előtte-utána összehasonlítás",
		brandTitle: "Arculati alapok",
		overviewTitle: "Az oldalak áttekintése",
		summaryTitle: "Összegzés",
		behindTitle: "A színfalak mögött: valódi szakemberek, több éves tapasztalattal",
		behindText:
			"A TASNADI csapatában a szakmai fejlődés, szakértelem és maximális figyelem alapértékek. Nem érjük be az átlagossal: a közös munkának nem csak az elkészült oldal kiváló, de a közös munka folyamata is legendás élmény az ügyfeleink számára.",
		ctaTitle: "Érdekel a szolgáltatásunk?",
		ctaText:
			"Jelentkezz egy ingyenes konzultációra, ahol felmérjük az elakadásaid, üzleti céljaid, és meghatározzuk a stratégiai lehetőségeket!",
		ctaButton: "Ajánlatot kérek",
		lightboxClose: "Bezárás",
		lightboxPrev: "Előző kép",
		lightboxNext: "Következő kép",
	},
	en: {
		strategy: "Strategy",
		design: "Design",
		implementation: "Implementation",
		startedTitle: "Where we started – where we arrived",
		compareLabel: "Before and after comparison",
		brandTitle: "Brand assets",
		overviewTitle: "Page Overview",
		summaryTitle: "Summary",
		behindTitle: "Behind the scenes: real experts with years of experience",
		behindText:
			"At TASNADI, professional growth, expertise, and attention to detail are core values. We never settle for average — every project is not only about the exceptional end result, but about creating a legendary client experience throughout the process.",
		ctaTitle: "Interested?",
		ctaText: "Let’s have a conversation and see how we can help boost your brand.",
		ctaButton: "Sounds interesting; let’s chat!",
		lightboxClose: "Close",
		lightboxPrev: "Previous image",
		lightboxNext: "Next image",
	},
}[locale];

// The comparison needs both screenshots and the testimonial needs a quote, otherwise they are hidden
const startedText = caseStudy.data.where_we_started_paragraph;
const previousVersion = caseStudy.data.where_we_started_previous_version;
const newVersion = caseStudy.data.where_we_started_new_version;
const hasComparison = Boolean(previousVersion && newVersion);

// The first paragraph of the quote is the highlighted one, the rest is shown smaller under it
const [quoteLead, ...quoteRest] = (caseStudy.data.testimonial_quote ?? "")
	.split(/\n+/)
	.map((paragraph) => paragraph.trim())
	.filter(Boolean);
const testimonialName = caseStudy.data.testimonial_name;
const testimonialPosition = caseStudy.data.testimonial_position;

const hasStartedSection = Boolean(startedText || hasComparison || quoteLead);

const brandText = caseStudy.data.brand_assets_paragraph;
const brandImage = caseStudy.data.brand_assets_image;
const hasBrandSection = Boolean(brandText || brandImage);

const overviewText = caseStudy.data.page_overview_paragraph;
const screenshots = (caseStudy.data.page_overview_screenshots ?? []).map((item) => item.image).filter(Boolean);
const useWhiteOverview = Boolean(caseStudy.data.page_overview_use_white_background);
const hasOverviewSection = Boolean(overviewText || screenshots.length > 0);

const summaryText = caseStudy.data.summary_paragraph;
const summaryImages = (caseStudy.data.summary_images ?? []).map((item) => item.image).filter(Boolean);
const hasSummarySection = Boolean(summaryText || summaryImages.length > 0);

// The team members of the project; the section is hidden when none is selected
const team = caseStudy.references?.our_team.entries ?? [];

// Two alternating rows: text on the left with the image on the right, then the other way around
const textImageRows = [
	{
		text: caseStudy.data.text_left_image_right_text ?? [],
		image: caseStudy.data.text_left_image_right_image,
		imageFirst: false,
	},
	{
		text: caseStudy.data.image_left_text_right_text ?? [],
		image: caseStudy.data.image_left_text_right_image,
		imageFirst: true,
	},
].filter((row) => row.text.length > 0 || row.image);

// The step name is set above, so a heading left in the CMS left column (the name) is not rendered twice
const withoutHeadings = <T extends { _type: string; style?: string }>(blocks?: T[] | null): T[] =>
	(blocks ?? []).filter((block) => !(block._type === "block" && /^h[1-6]$/.test(block.style ?? "")));

const steps = [
	{
		label: copy.strategy,
		left: withoutHeadings(caseStudy.data.step_1_left_column),
		right: caseStudy.data.step_1_right_column ?? [],
	},
	{
		label: copy.design,
		left: withoutHeadings(caseStudy.data.step_2_left_column),
		right: caseStudy.data.step_2_right_column ?? [],
	},
	{
		label: copy.implementation,
		left: withoutHeadings(caseStudy.data.step_3_left_column),
		right: caseStudy.data.step_3_right_column ?? [],
	},
].filter((step) => step.left.length > 0 || step.right.length > 0);

const stepLeftClass =
	"text-base leading-[1.625rem] font-medium text-text-muted lg:text-right [&_ul]:m-0 [&_ul]:list-none [&_ul]:p-0 [&_li]:my-2 [&_li]:p-0 [&_p]:my-2";
// Styles the CMS rich text of the step columns and the text and image rows, whose heading is an h3 or an h2
const richTextClass = [
	"text-base leading-[1.625rem] font-light text-text-muted",
	"[&>:first-child]:mt-0",
	"[&_:is(h2,h3)]:mt-0 [&_:is(h2,h3)]:mb-6 [&_:is(h2,h3)]:text-heading [&_:is(h2,h3)]:font-medium [&_:is(h2,h3)]:text-text",
	"[&_p]:my-0 [&_p+p]:mt-3",
	"[&_strong]:font-bold [&_strong]:text-text",
	"[&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors [&_a]:duration-200 [&_a:hover]:text-primary motion-reduce:[&_a]:transition-none",
	"[&_ul]:my-3 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:my-1 [&_li]:pl-1 [&_li::marker]:text-text",
];

const { siteTitle } = resolveSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(caseStudy, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: localizePath(`/work/${slug}`, locale),
});
const alternates = await getEntryAlternates("case_studies", caseStudy.data.id, (s) => `/work/${s}`);
---

<Base
	title={seo.title}
	titleOverride={getContentSeo(caseStudy)?.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? caseStudy.data.short_description}
	canonical={seo.canonical}
	{alternates}
	content={{ collection: "case_studies", id: caseStudy.data.id, slug }}
	navVariant="dark"
>
	<section class="relative bg-background-dark pt-[11.25rem] pb-28 max-lg:pt-40 max-lg:pb-16">
		<img
			src="/global/images/space-bg.webp"
			alt=""
			width="1512"
			height="1294"
			loading="eager"
			fetchpriority="high"
			class="absolute inset-0 size-full object-cover object-center"
		/>

		<div
			aria-hidden="true"
			class="absolute inset-x-0 bottom-0 z-10 h-12 rounded-t-[50%_100%] bg-background max-lg:h-8"
		>
		</div>

		<div
			class="relative mx-auto grid w-[92%] max-w-[76.875rem] items-end gap-x-8 gap-y-10 text-text-inverse lg:grid-cols-2"
		>
			<div class="flex flex-col items-start gap-5">
				{
					tags.length > 0 && (
						<ul class="flex flex-wrap gap-2">
							{tags.map((tag) => (
								<li>
									<Badge>{tag}</Badge>
								</li>
							))}
						</ul>
					)
				}
				<h1
					class="font-medium text-heading"
				>
					{caseStudy.data.hero_text}
				</h1>
				{
					caseStudy.data.short_description && (
						<p class="text-base leading-[1.625rem] font-light">{caseStudy.data.short_description}</p>
					)
				}
			</div>

			{
				caseStudy.data.image && (
					<Image
						image={caseStudy.data.image}
						sizes="(min-width: 64rem) 37.5rem, 92vw"
						loading="eager"
						fetchpriority="high"
						class="relative z-20 h-auto w-full lg:-mb-40 max-lg:mb-[calc(-4rem_-_11.5%)]"
					/>
				)
			}
		</div>
	</section>

	<section class="bg-background pt-28 pb-16 max-lg:pt-24 max-lg:pb-12">
		<div class="mx-auto flex w-[92%] max-w-[50rem] flex-col gap-16">
			{
				steps.map((step) => (
					<div class="grid gap-x-10 gap-y-4 lg:grid-cols-[11rem_1fr]">
						<div>
							<h2 class="mb-3 text-2xl leading-9 font-bold text-primary lg:text-right">{step.label}</h2>
							<div class={stepLeftClass}>
								<PortableText value={step.left} />
							</div>
						</div>
						<div class:list={richTextClass}>
							<PortableText value={step.right} />
						</div>
					</div>
				))
			}
		</div>
	</section>

	{
		hasStartedSection && (
			<section class="bg-background pb-24 max-lg:pb-16">
				<div class="mx-auto flex w-[92%] max-w-[50rem] justify-end">
					<svg
						aria-hidden="true"
						viewBox="0 0 69 72"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						class="h-auto w-[4.25rem] max-lg:w-14"
					>
						<path
							class="fill-accent"
							d="M48.1831 2.67429C48.4969 1.78439 49.7555 1.78439 50.0693 2.67429L54.5147 15.2803C54.6065 15.5405 54.8017 15.7513 55.0542 15.8626L66.6117 20.9605C67.4069 21.3112 67.4069 22.4396 66.6117 22.7904L55.0542 27.8882C54.8017 27.9995 54.6065 28.2103 54.5147 28.4706L50.0693 41.0765C49.7555 41.9664 48.4969 41.9664 48.1831 41.0765L43.7377 28.4706C43.6459 28.2103 43.4507 27.9995 43.1982 27.8882L31.6407 22.7904C30.8455 22.4396 30.8455 21.3112 31.6407 20.9605L43.1982 15.8626C43.4507 15.7513 43.6459 15.5405 43.7377 15.2803L48.1831 2.67429Z"
						/>
						<path
							class="fill-primary"
							d="M14.0378 45.5582C14.3836 44.7485 15.5314 44.7485 15.8772 45.5582L19.0179 52.914C19.1265 53.1683 19.3355 53.3663 19.5953 53.4609L27.3358 56.2808C28.2127 56.6002 28.2127 57.8405 27.3358 58.1599L19.5953 60.9798C19.3355 61.0744 19.1265 61.2724 19.0179 61.5267L15.8772 68.8825C15.5314 69.6922 14.3836 69.6922 14.0378 68.8825L10.8971 61.5267C10.7885 61.2724 10.5795 61.0744 10.3197 60.9798L2.5792 58.1599C1.70225 57.8405 1.70225 56.6002 2.5792 56.2808L10.3197 53.4609C10.5795 53.3663 10.7885 53.1683 10.8971 52.914L14.0378 45.5582Z"
						/>
					</svg>
				</div>

				<div class="mx-auto mt-8 w-[92%] max-w-[76.875rem] max-lg:mt-6">
					<h2 class="mx-auto text-center font-medium text-heading">
						{copy.startedTitle}
					</h2>

					{
						hasComparison && (
							<div
								data-compare
								style="--position: 50%"
								class="relative mt-10 overflow-hidden rounded-[20px] shadow-[0_4px_30px_color-mix(in_srgb,var(--color-shadow)_15%,transparent)] select-none max-lg:mt-8"
							>
								<Image
									image={newVersion}
									sizes="(min-width: 64rem) 76.875rem, 92vw"
									loading="lazy"
									class="block h-auto w-full"
								/>
								<Image
									image={previousVersion}
									sizes="(min-width: 64rem) 76.875rem, 92vw"
									loading="lazy"
									class="absolute inset-0 size-full [clip-path:inset(0_calc(100%_-_var(--position))_0_0)] object-cover"
								/>
								<input
									type="range"
									min="0"
									max="100"
									step="0.1"
									value="50"
									aria-label={copy.compareLabel}
									class="peer absolute inset-0 z-20 size-full cursor-ew-resize touch-pan-y opacity-0"
								/>
								<div
									aria-hidden="true"
									class="pointer-events-none absolute inset-y-0 left-[var(--position)] z-10 w-0.5 -translate-x-1/2 bg-background shadow-[0_0_8px_color-mix(in_srgb,var(--color-shadow)_40%,transparent)] peer-focus-visible:[&_div]:outline-2 peer-focus-visible:[&_div]:outline-offset-2 peer-focus-visible:[&_div]:outline-accent"
								>
									<div class="absolute top-1/2 left-1/2 flex size-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-background text-text shadow-[0_2px_12px_color-mix(in_srgb,var(--color-shadow)_30%,transparent)] lg:size-20">
										<svg width="28" height="16" viewBox="0 0 28 16" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path
												d="M9 2 3 8l6 6M19 2l6 6-6 6"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
									</div>
								</div>
							</div>
						)
					}

					{
						startedText && (
							<p class="mx-auto mt-8 max-w-[43rem] text-center text-base leading-[1.625rem] font-light text-text-muted">
								{startedText}
							</p>
						)
					}

					{
						quoteLead && (
							<figure class="relative z-10 mx-auto mt-12 flex flex-col items-center rounded-[24px] border border-primary/50 bg-background bg-linear-to-br from-primary/10 via-background via-25% to-accent/10 px-8 py-6 text-center max-lg:px-5 max-lg:mt-10">
								<svg
									aria-hidden="true"
									width="32"
									height="32"
									viewBox="0 0 24 24"
									class="fill-primary"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path d="M12 0c.6 6.5 5.5 11.4 12 12-6.5.6-11.4 5.5-12 12-.6-6.5-5.5-11.4-12-12C6.5 11.4 11.4 6.5 12 0Z" />
								</svg>
								<blockquote class="mt-2 max-w-[54.75rem]">
									<p class="text-[2.125rem] leading-[2.75rem] font-medium text-text max-lg:text-2xl max-lg:leading-8">
										{quoteLead}
									</p>
									{quoteRest.map((paragraph) => (
										<p class="mx-auto mt-3 max-w-[32.5rem] text-base leading-[1.625rem] font-light text-text-muted">
											{paragraph}
										</p>
									))}
								</blockquote>
								{(testimonialName || testimonialPosition) && (
									<figcaption class="mt-3 text-base leading-[1.625rem] text-text">
										{testimonialName && <strong class="block font-bold">{testimonialName}</strong>}
										{testimonialPosition && <em class="block font-light">{testimonialPosition}</em>}
									</figcaption>
								)}
							</figure>
						)
					}
				</div>
			</section>
		)
	}

	{
		hasBrandSection && (
			<section
				class:list={[
					"relative bg-background-dark pb-24 max-lg:pt-32 max-lg:pb-16",
					// The testimonial card above reaches over the curve, which is 6vw tall, so the pull-up grows with the width
					quoteLead
						? "-mt-[calc(6rem_+_6vw_+_0.5rem)] pt-[12.5rem] max-lg:-mt-[calc(4rem_+_6vw_+_0.5rem)]"
						: "pt-36",
				]}
			>
				<img
					src="/global/images/space-bg.webp"
					alt=""
					width="1512"
					height="1294"
					loading="lazy"
					class="absolute inset-0 size-full object-cover object-center"
				/>

				<svg
					aria-hidden="true"
					viewBox="0 0 1512 91"
					preserveAspectRatio="none"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					class="absolute inset-x-0 -top-px h-auto w-full"
				>
					<path class="fill-background" d="M0 0H1512V34C1512 34 1246.5 90.5 756 90.5C265.5 90.5 0 34 0 34V0Z" />
				</svg>

				<div class="relative mx-auto w-[92%] max-w-[76.875rem] text-text-inverse">
					<h2 class="mx-auto text-center font-medium text-heading">
						{copy.brandTitle}
					</h2>

					{brandText && (
						<p class="mx-auto mt-8 max-w-[43rem] text-center text-base leading-[1.625rem] font-light">
							{brandText}
						</p>
					)}

					{brandImage && (
						<Image
							image={brandImage}
							sizes="(min-width: 64rem) 57.75rem, 92vw"
							loading="lazy"
							class="mx-auto mt-12 h-auto w-full max-w-[57.75rem] rounded-[20px] max-lg:mt-8"
						/>
					)}
				</div>
			</section>
		)
	}

	{
		textImageRows.length > 0 && (
			<section class="bg-background py-24 max-lg:py-16">
				<div class="mx-auto flex w-[92%] max-w-[76.875rem] flex-col gap-20 max-lg:gap-14">
					{textImageRows.map((row) => (
						<div class="grid items-center gap-x-8 gap-y-8 lg:grid-cols-2">
							{row.text.length > 0 && (
								<div
									class:list={[
										richTextClass,
										row.imageFirst ? "lg:col-start-2 lg:row-start-1" : "lg:col-start-1 lg:row-start-1",
									]}
								>
									<PortableText value={row.text} />
								</div>
							)}
							{row.image && (
								<Image
									image={row.image}
									sizes="(min-width: 64rem) 37.5rem, 92vw"
									loading="lazy"
									class:list={[
										"h-auto w-full max-lg:order-first lg:row-start-1",
										row.imageFirst ? "lg:col-start-1" : "lg:col-start-2",
									]}
								/>
							)}
						</div>
					))}
				</div>
			</section>
		)
	}

	{
		hasOverviewSection && (
			<section
				class:list={[
					"py-16 max-lg:py-12",
					useWhiteOverview ? "bg-background text-text" : "bg-background-dark text-text-inverse",
				]}
			>
				<div class="mx-auto w-[92%] max-w-[76.875rem]">
					<h2 class="mx-auto text-center font-medium text-heading">
						{copy.overviewTitle}
					</h2>

					{overviewText && (
						<p class="mx-auto mt-8 max-w-[35.5rem] text-center text-base leading-[1.625rem] font-light">
							{overviewText}
						</p>
					)}

					{screenshots.length > 0 && (
						<div
							data-lightbox
							data-close-label={copy.lightboxClose}
							data-prev-label={copy.lightboxPrev}
							data-next-label={copy.lightboxNext}
							class="mt-12 columns-3 gap-10 max-lg:mt-8 max-lg:columns-2 max-sm:columns-1"
						>
							{screenshots.map((image) => (
								<a
									href={mediaFileUrl(image)}
									data-pswp-width={image.width}
									data-pswp-height={image.height}
									class="mb-10 block cursor-zoom-in break-inside-avoid focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
								>
									<Image
										image={image}
										sizes="(min-width: 64rem) 25rem, (min-width: 40rem) 50vw, 92vw"
										loading="lazy"
										class="block h-auto w-full"
									/>
								</a>
							))}
						</div>
					)}
				</div>
			</section>
		)
	}

	{
		hasSummarySection && (
			<section class="relative overflow-x-clip bg-background pt-32 pb-24 lg:pt-[11.25rem] max-lg:pb-16">
				<img
					data-about-astronaut
					data-direction="right"
					src="/global/images/astronaut-black.webp"
					alt=""
					width="296"
					height="264"
					loading="lazy"
					class="pointer-events-none absolute top-0 left-4 z-10 w-28 will-change-transform sm:w-36 lg:left-[4.5rem] lg:w-[11.25rem]"
				/>

				<div class="relative mx-auto w-[92%] max-w-[76.875rem]">
					<h2 class="mx-auto text-center font-medium text-heading">
						{copy.summaryTitle}
					</h2>

					{summaryText && (
						<p class="mx-auto mt-8 max-w-[43rem] text-center text-base leading-[1.625rem] font-light text-text">
							{summaryText}
						</p>
					)}

					{summaryImages.length > 0 && (
						<ul class="mx-auto mt-12 flex max-w-[69.5rem] flex-col gap-12 max-lg:mt-8 max-lg:gap-8">
							{summaryImages.map((image) => (
								<li>
									<figure>
										<Image
											image={image}
											sizes="(min-width: 76.875rem) 69.5rem, 92vw"
											loading="lazy"
											class="h-auto w-full rounded-[20px]"
										/>
										{image.caption && (
											<figcaption class="mt-3 text-center text-sm leading-5 text-text">{image.caption}</figcaption>
										)}
									</figure>
								</li>
							))}
						</ul>
					)}
				</div>
			</section>
		)
	}

	{
		team.length > 0 && (
			<section class="bg-background pt-8 pb-24 max-lg:pb-16">
				<div class="mx-auto w-[92%] max-w-[76.875rem]">
					<h2 class="mx-auto max-w-[56.5rem] text-center font-medium text-heading">
						{copy.behindTitle}
					</h2>
					<p class="mx-auto mt-8 max-w-[38rem] text-center text-base leading-[1.625rem] font-light text-text">
						{copy.behindText}
					</p>
					<TeamList people={team} class="mt-12 max-lg:mt-8" />
				</div>
			</section>
		)
	}

	<section class="relative overflow-x-clip bg-background pt-48 pb-24 lg:pt-[13.75rem] lg:pb-[10rem]">
		<img
			src="/about/cta/planet-bg.svg"
			alt=""
			width="1512"
			height="600"
			loading="lazy"
			class="pointer-events-none absolute inset-x-0 top-0 h-auto w-full"
		/>
		<img
			src="/work/astronaut.webp"
			alt=""
			width="447"
			height="583"
			loading="lazy"
			class="pointer-events-none absolute top-8 left-1/2 w-32 translate-x-4 lg:w-[13.75rem] lg:translate-x-[18rem]"
		/>

		<div class="relative mx-auto w-[92%] max-w-[76.875rem]">
			<CtaBox
				title={copy.ctaTitle}
				text={copy.ctaText}
				buttonLabel={copy.ctaButton}
				buttonHref={localizePath("/contact", locale)}
			/>
		</div>
	</section>
</Base>

<script>
	// Moves the before/after divider of the comparison slider with its range input.
	document.querySelectorAll<HTMLElement>("[data-compare]").forEach((root) => {
		const input = root.querySelector<HTMLInputElement>("input");
		if (!input) return;
		const update = () => root.style.setProperty("--position", `${input.value}%`);
		input.addEventListener("input", update);
		update();
	});
</script>

